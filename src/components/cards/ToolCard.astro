---
import Icon from "../ui/Icon.astro";
import { isExternal } from "../../lib/links";

interface Props {
  name: string;
  tagline: string;
  category: string;
  icon: string;
  href: string;
  comingSoon?: boolean;
}
const { name, tagline, category, icon, href, comingSoon = false } = Astro.props;
const external = isExternal(href);
const Tag = comingSoon ? "div" : "a";
const linkAttrs = comingSoon
  ? {}
  : external
    ? { href, target: "_blank", rel: "noopener" }
    : { href };
---

<Tag class:list={["tool", { soon: comingSoon }]} {...linkAttrs}>
  <span class="glyph"><Icon name={icon} size={20} /></span>
  <span class="category">{category}</span>
  <h3>{name}</h3>
  <p>{tagline}</p>
  {comingSoon ? <span class="badge">Coming soon</span> : <span class="go">Explore</span>}
</Tag>

<style>
  .tool {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-page);
    box-shadow: var(--shadow-sm);
    color: var(--text-strong);
    text-decoration: none;
    transition: transform 0.16s ease, border-color 0.16s ease;
  }
  a.tool:hover {
    transform: translateY(-3px);
    border-color: var(--accent-text);
  }
  @media (prefers-reduced-motion: reduce) {
    a.tool:hover {
      transform: none;
    }
  }
  .soon {
    opacity: 0.82;
  }
  .glyph {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 9px;
    background: var(--surface-wash);
    color: var(--accent-text);
  }
  .category {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  h3 {
    font-size: 1.06rem;
  }
  p {
    flex: 1;
    color: var(--text-body);
    font-size: 0.85rem;
  }
  .go {
    color: var(--accent-text);
    font-size: 0.82rem;
    font-weight: 800;
  }
  .go::after {
    content: " →";
  }
  .badge {
    align-self: flex-start;
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--surface-teal-wash);
    color: var(--accent-text);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
</style>
