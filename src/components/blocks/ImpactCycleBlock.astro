---
import type { Block } from "../../schemas/blocks";
import GeoGlyph from "../site/GeoGlyph.astro";

const { eyebrow, stageTag, heading, intro, steps, stats, quote } =
  Astro.props as Extract<Block, { type: "impactCycle" }>;
const kicker = stageTag ? `${eyebrow} · ${stageTag}` : eyebrow;
---

<section class="block impact">
  <div class="shell">
    <div class="head">
      {kicker && <p class="eyebrow"><GeoGlyph />{kicker}</p>}
      <h2>{heading}</h2>
      {intro && <p class="intro">{intro}</p>}
    </div>

    <ol class="cycle">
      {
        steps.map((s) => (
          <li class="step">
            <span class="idx">{s.idx}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="grid">
      {
        quote && (
          <figure class="quote">
            <blockquote>{quote.text}</blockquote>
            <figcaption>{quote.who}</figcaption>
            {quote.note && <p class="note">{quote.note}</p>}
          </figure>
        )
      }
      {
        stats.length > 0 && (
          <div class="stats">
            {stats.map((s) => (
              <div class="stat">
                <div class="num">{s.num}</div>
                <div class="lbl">{s.lbl}</div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .impact {
    background: var(--color-navy-deep);
    color: var(--ink-on-dark-muted);
  }
  .head {
    max-width: 640px;
    margin-bottom: 44px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--color-teal);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  h2 {
    color: var(--ink-on-dark);
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    letter-spacing: -0.02em;
  }
  .intro {
    margin-top: 14px;
    color: var(--ink-on-dark-muted);
    font-size: 1.05rem;
  }

  /* Cycle: full-width sequence with connector arrows */
  .cycle {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  @media (max-width: 760px) {
    .cycle {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 440px) {
    .cycle {
      grid-template-columns: 1fr;
    }
  }
  .step {
    position: relative;
    padding: 22px;
    border: 1px solid var(--hairline-on-dark);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
  }
  .step:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -12px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-navy-deep);
    border: 1px solid var(--hairline-on-dark);
    color: var(--color-teal);
    font-size: 12px;
  }
  @media (max-width: 760px) {
    .step::after {
      display: none;
    }
  }
  .idx {
    color: var(--color-teal);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .step h3 {
    margin-top: 10px;
    color: var(--ink-on-dark);
    font-size: 1.05rem;
  }
  .step p {
    margin-top: 8px;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  /* Quote + stats row, content-sized (no stretch-induced empty space) */
  .grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .quote {
    position: relative;
    margin: 0;
    padding: 26px 30px 24px 62px;
    border: 1px solid var(--hairline-on-dark);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.03);
  }
  .quote::before {
    content: "\201C";
    position: absolute;
    left: 22px;
    top: 20px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 3.4rem;
    line-height: 1;
    color: var(--color-teal);
  }
  blockquote {
    margin: 0;
    color: var(--ink-on-dark);
    font-size: 1.28rem;
    font-weight: 600;
    line-height: 1.42;
  }
  figcaption {
    margin-top: 14px;
    font-size: 0.88rem;
    color: var(--ink-on-dark-muted);
  }
  .quote .note {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline-on-dark);
    font-size: 0.78rem;
    color: var(--ink-on-dark-muted);
  }
  .stats {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  @media (max-width: 820px) {
    .stats {
      flex-direction: row;
    }
    .stat {
      flex: 1;
    }
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 22px;
    border: 1px solid var(--hairline-on-dark);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
  }
  .num {
    color: var(--color-teal);
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .lbl {
    font-size: 0.82rem;
    line-height: 1.4;
  }
</style>
