---
import type { Block } from "../../schemas/blocks";
import GeoGlyph from "../site/GeoGlyph.astro";
import { bgImage } from "../../lib/css";

const { eyebrow, stageTag, heading, intro, steps, stats, quote, story } =
  Astro.props as Extract<Block, { type: "impactCycle" }>;
const kicker = stageTag ? `${eyebrow} · ${stageTag}` : eyebrow;
const StoryTag = story?.href ? "a" : "div";
---

<section class="block impact">
  <div class="shell">
    <div class="head">
      {kicker && <p class="eyebrow"><GeoGlyph />{kicker}</p>}
      <h2>{heading}</h2>
      {intro && <p class="intro">{intro}</p>}
    </div>

    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step">
            <span class="node">{i + 1}</span>
            <span class="phase">{s.idx}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="grid">
      {
        story ? (
          <StoryTag class="story" {...(story.href ? { href: story.href } : {})}>
            <div class="cover" style={bgImage(story.image)} />
            <div class="s-body">
              <span class="loc">{story.location}</span>
              <h3>{story.title}</h3>
              {story.note && <p class="s-note">{story.note}</p>}
            </div>
          </StoryTag>
        ) : (
          quote && (
            <figure class="quote">
              <blockquote>{quote.text}</blockquote>
              <figcaption>{quote.who}</figcaption>
              {quote.note && <p class="s-note">{quote.note}</p>}
            </figure>
          )
        )
      }
      {
        stats.length > 0 && (
          <div class="stats">
            {stats.map((s) => (
              <div class="stat">
                <div class="num" data-count>{s.num}</div>
                <div class="lbl">{s.lbl}</div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .impact {
    background: var(--color-navy-deep);
    color: var(--ink-on-dark-muted);
  }
  .head {
    max-width: 640px;
    margin-bottom: 48px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--color-teal);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  h2 {
    color: var(--ink-on-dark);
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    letter-spacing: -0.02em;
  }
  .intro {
    margin-top: 14px;
    color: var(--ink-on-dark-muted);
    font-size: 1.05rem;
  }

  /* Numbered stepper */
  .steps {
    list-style: none;
    margin: 0 0 36px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .step {
    position: relative;
    padding-right: 30px;
  }
  .step::before {
    content: "";
    position: absolute;
    top: 18px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--hairline-on-dark);
  }
  .step:last-child::before {
    display: none;
  }
  .node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-teal);
    color: var(--color-navy-deep);
    font-weight: 800;
    font-size: 1rem;
    box-shadow: 0 0 0 6px var(--color-navy-deep);
    margin-bottom: 18px;
  }
  .phase {
    display: block;
    color: var(--color-teal);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .step h3 {
    margin-top: 6px;
    color: var(--ink-on-dark);
    font-size: 1.08rem;
  }
  .step p {
    margin-top: 8px;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--ink-on-dark-muted);
  }
  @media (max-width: 760px) {
    .steps {
      grid-template-columns: 1fr 1fr;
      gap: 28px 0;
    }
    .step::before {
      display: none;
    }
  }
  @media (max-width: 440px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  /* Story + stats row */
  .grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .story {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    overflow: hidden;
    border: 1px solid var(--hairline-on-dark);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.03);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  a.story:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }
  @media (prefers-reduced-motion: reduce) {
    a.story:hover {
      transform: none;
    }
  }
  @media (max-width: 520px) {
    .story {
      grid-template-columns: 1fr;
    }
  }
  .cover {
    background-size: cover;
    background-position: center;
    min-height: 200px;
  }
  .s-body {
    padding: 26px 28px;
    align-self: center;
  }
  .loc {
    color: var(--color-teal);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .story h3 {
    margin-top: 8px;
    color: var(--ink-on-dark);
    font-size: 1.3rem;
    line-height: 1.32;
  }
  .s-note {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--hairline-on-dark);
    font-size: 0.78rem;
    color: var(--ink-on-dark-muted);
  }
  .quote {
    margin: 0;
    padding: 26px 30px;
    border: 1px solid var(--hairline-on-dark);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.03);
  }
  blockquote {
    margin: 0;
    color: var(--ink-on-dark);
    font-size: 1.28rem;
    font-weight: 600;
    line-height: 1.42;
  }
  figcaption {
    margin-top: 14px;
    font-size: 0.88rem;
  }
  .stats {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  @media (max-width: 820px) {
    .stats {
      flex-direction: row;
    }
    .stat {
      flex: 1;
    }
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 22px;
    border: 1px solid var(--hairline-on-dark);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
  }
  .num {
    color: var(--color-teal);
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .lbl {
    font-size: 0.82rem;
    line-height: 1.4;
  }
</style>
