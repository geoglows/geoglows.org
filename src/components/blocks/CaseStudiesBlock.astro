---
import type { Block } from "../../schemas/blocks";
import { isExternal } from "../../lib/links";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, items, cta } = Astro.props as Extract<
  Block,
  { type: "caseStudies" }
>;
---

<section class="block muted">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <div class="grid">
      {
        items.map((item) => {
          const Tag = item.href ? "a" : "article";
          const linkAttrs =
            item.href && isExternal(item.href)
              ? { href: item.href, target: "_blank", rel: "noopener" }
              : item.href
                ? { href: item.href }
                : {};
          return (
            <Tag class:list={["case", { illustrated: !!item.image }]} {...linkAttrs}>
              {item.image && (
                <img
                  class="shot"
                  src={item.image}
                  alt=""
                  width="720"
                  height="405"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="loc">
                {item.location}
                {item.kind && <span class="kind">{item.kind}</span>}
              </span>
              <h3>{item.title}</h3>
              {item.text && <p>{item.text}</p>}
              <div class="foot">
                {item.source && <span class="source">{item.source}</span>}
                {item.href && <span class="more">Learn more →</span>}
              </div>
            </Tag>
          );
        })
      }
    </div>
    {
      cta && (
        <p class="all">
          <a href={cta.href}>{cta.label} →</a>
        </p>
      )
    }
  </div>
</section>

<style>
  .muted {
    background: var(--surface-muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }
  .case {
    display: flex;
    flex-direction: column;
    padding: 24px 24px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-page);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  a.case:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  a.case:hover .more {
    text-decoration: underline;
  }
  @media (prefers-reduced-motion: reduce) {
    a.case:hover {
      transform: none;
    }
  }
  .loc {
    color: var(--accent-text);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h3 {
    margin-top: 8px;
    font-size: 1.12rem;
    line-height: 1.3;
    color: var(--text-strong);
  }
  p {
    margin-top: 10px;
    color: var(--text-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
  }
  .source {
    color: var(--text-faint);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .more {
    color: var(--accent-text);
    font-weight: 800;
    font-size: 0.85rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .all {
    margin-top: 28px;
  }
  .all a {
    color: var(--accent-text);
    font-weight: 800;
    text-decoration: none;
  }

  /* Field stories run shorter and carry a photo; keeping both depths in one
     grid is the point, so the two shapes are allowed to look different. */
  .shot {
    display: block;
    width: calc(100% + 2px);
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: -1px -1px 16px;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .illustrated {
    padding-top: 0;
  }
  .kind {
    margin-left: 9px;
    padding-left: 9px;
    border-left: 1px solid var(--border);
    color: var(--text-faint);
    font-weight: 700;
  }
</style>