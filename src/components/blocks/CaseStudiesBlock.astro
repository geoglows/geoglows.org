---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, items, cta } = Astro.props as Extract<
  Block,
  { type: "caseStudies" }
>;
const external = (href: string) => /^https?:\/\//.test(href);
---

<section class="block muted">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <div class="grid">
      {
        items.map((item) => {
          const Tag = item.href ? "a" : "article";
          const linkAttrs =
            item.href && external(item.href)
              ? { href: item.href, target: "_blank", rel: "noopener" }
              : item.href
                ? { href: item.href }
                : {};
          return (
            <Tag class="case" {...linkAttrs}>
              <span class="loc">{item.location}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <div class="foot">
                {item.source && <span class="source">{item.source}</span>}
                {item.href && <span class="more">Learn more →</span>}
              </div>
            </Tag>
          );
        })
      }
    </div>
    {
      cta && (
        <p class="all">
          <a href={cta.href}>{cta.label} →</a>
        </p>
      )
    }
  </div>
</section>

<style>
  .muted {
    background: var(--surface-muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }
  .case {
    display: flex;
    flex-direction: column;
    padding: 24px 24px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-page);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  a.case:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  a.case:hover .more {
    text-decoration: underline;
  }
  @media (prefers-reduced-motion: reduce) {
    a.case:hover {
      transform: none;
    }
  }
  .loc {
    color: var(--accent-text);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h3 {
    margin-top: 8px;
    font-size: 1.12rem;
    line-height: 1.3;
    color: var(--text-strong);
  }
  p {
    margin-top: 10px;
    color: var(--text-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
  }
  .source {
    color: var(--text-faint);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .more {
    color: var(--accent-text);
    font-weight: 800;
    font-size: 0.85rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .all {
    margin-top: 28px;
  }
  .all a {
    color: var(--accent-text);
    font-weight: 800;
    text-decoration: none;
  }
</style>
