---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, items, contactEmail } = Astro.props as Extract<
  Block,
  { type: "audienceCards" }
>;
const external = (href: string) => /^https?:\/\//.test(href);
---

<section class="block muted">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <div class="grid">
      {
        items.map((item) => {
          const Tag = item.href ? "a" : "div";
          const attrs = item.href
            ? external(item.href)
              ? { href: item.href, target: "_blank", rel: "noopener" }
              : { href: item.href }
            : {};
          return (
            <Tag class="card" {...attrs}>
              <span class="kicker">{item.kicker}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              {item.href && <span class="go">Learn more →</span>}
            </Tag>
          );
        })
      }
    </div>
    {
      contactEmail && (
        <p class="contact">
          Start a conversation: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </p>
      )
    }
  </div>
</section>

<style>
  .muted {
    background: var(--surface-wash);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-page);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  a.card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    a.card:hover {
      transform: none;
    }
  }
  .go {
    margin-top: auto;
    padding-top: 14px;
    color: var(--accent-text);
    font-weight: 800;
    font-size: 0.85rem;
  }
  a.card:hover .go {
    text-decoration: underline;
  }
  .kicker {
    color: var(--accent-text);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h3 {
    margin-top: 8px;
    font-size: 1.05rem;
  }
  p {
    margin-top: 8px;
    color: var(--text-body);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .contact {
    margin-top: 24px;
    color: var(--text-body);
    font-size: 0.95rem;
  }
  .contact a {
    color: var(--accent-text);
    font-weight: 700;
    text-decoration: none;
  }
</style>
