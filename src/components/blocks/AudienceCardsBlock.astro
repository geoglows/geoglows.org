---
import type { Block } from "../../schemas/blocks";
import { isExternal } from "../../lib/links";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, items, contactEmail } = Astro.props as Extract<
  Block,
  { type: "audienceCards" }
>;

// Not every way in carries the same weight. The primary paths stay cards; the
// lighter ones render as a row beneath, so six equal boxes stop reading as a grid.
const primary = items.filter((i) => !i.minor);
const secondary = items.filter((i) => i.minor);
const linkAttrs = (href?: string) =>
  href ? (isExternal(href) ? { href, target: "_blank", rel: "noopener" } : { href }) : {};
---

<section class="block muted">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <div class="grid">
      {
        primary.map((item) => {
          const Tag = item.href ? "a" : "div";
          return (
            <Tag class="card" {...linkAttrs(item.href)}>
              <span class="kicker">{item.kicker}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              {item.href && <span class="go">Learn more →</span>}
            </Tag>
          );
        })
      }
    </div>
    {
      secondary.length > 0 && (
        <ul class="also">
          {secondary.map((item) => {
            const Tag = item.href ? "a" : "span";
            return (
              <li>
                <Tag class="also-link" {...linkAttrs(item.href)}>
                  <span class="also-title">{item.title}</span>
                  <span class="also-text">{item.text}</span>
                </Tag>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</section>

<style>
  .muted {
    background: var(--surface-wash);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 18px;
  }

  /* Secondary ways in: same information, a quieter shape. */
  .also {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 10px 32px;
    list-style: none;
    margin: 26px 0 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--border);
  }
  .also-link {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-height: 44px;
    padding: 6px 0;
    color: inherit;
    text-decoration: none;
  }
  .also-title {
    color: var(--accent-text);
    font-weight: 800;
    font-size: 0.92rem;
  }
  a.also-link:hover .also-title {
    text-decoration: underline;
  }
  .also-text {
    color: var(--text-body);
    font-size: 0.86rem;
    line-height: 1.5;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-page);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  a.card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    a.card:hover {
      transform: none;
    }
  }
  .go {
    margin-top: auto;
    padding-top: 14px;
    color: var(--accent-text);
    font-weight: 800;
    font-size: 0.85rem;
  }
  a.card:hover .go {
    text-decoration: underline;
  }
  .kicker {
    color: var(--accent-text);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h3 {
    margin-top: 8px;
    font-size: 1.05rem;
  }
  p {
    margin-top: 8px;
    color: var(--text-body);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
