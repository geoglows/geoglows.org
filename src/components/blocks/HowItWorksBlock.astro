---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";
import NetworkWatermark from "../ui/NetworkWatermark.astro";

const { eyebrow, heading, intro, steps, cta } = Astro.props as Extract<
  Block,
  { type: "howItWorks" }
>;
const pad = (index: number) => String(index + 1).padStart(2, "0");
---

<section class="block steps-flow">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} />
    <div class="flow">
      <div class="mark-zone"><NetworkWatermark /></div>
      <ol class="chain">
        {
          steps.map((step, index) => (
            <li class="stage">
              <span class="node">{pad(index)}</span>
              <div class="body">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                {step.ref && (
                  <p class="ref">
                    <a href={step.ref.href} target="_blank" rel="noopener">
                      {step.ref.label} ↗
                    </a>
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    {
      cta && (
        <p class="go">
          <a href={cta.href} target="_blank" rel="noopener">
            {cta.label} →
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .steps-flow {
    padding-block: clamp(52px, 7vw, 96px);
    /* The watermark bleeds past the shell; the section is what crops it. */
    overflow: hidden;
  }
  .flow {
    position: relative;
  }

  /* One column, top to bottom. Three columns made a chain of seven read as a
     grid of peers: the reading order was ambiguous and nothing carried the
     direction except the numerals. */
  .chain {
    --rail: 54px;
    --gap: clamp(24px, 2.6vw, 32px);
    --chain-max: 600px;
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    row-gap: var(--gap);
    /* Caps the text column so the stage boxes, not just the glyphs, stop short
       of the texture. The 1fr cell stretched the full shell even where the
       title was three words long. */
    max-width: var(--chain-max);
  }
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    column-gap: 22px;
    align-items: start;
  }
  /* The rail itself: from this stage's numeral down to the next one's. The
     numerals sit on it rather than floating above separate blocks. */
  .stage:not(:last-child)::before {
    content: "";
    position: absolute;
    left: calc(var(--rail) / 2 - 1px);
    top: calc(var(--rail) / 2);
    height: calc(100% + var(--gap) - var(--rail) / 2);
    width: 2px;
    background: color-mix(in srgb, var(--accent-strong) 32%, transparent);
  }
  .node {
    position: relative;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: var(--rail);
    height: var(--rail);
    border-radius: 50%;
    border: 2px solid var(--accent-strong);
    background: var(--surface-page);
    color: var(--accent-strong);
    font-family: "Raleway", sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .body {
    padding-top: 13px;
  }
  .body h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  .body p {
    margin-top: 10px;
    max-width: 58ch;
    color: var(--text-body);
    font-size: 0.98rem;
    line-height: 1.65;
  }
  /* A stage that names an outside dataset or model hands the reader a way to
     go and check it, instead of leaving the acronym to be taken on faith. */
  .body p.ref {
    margin-top: 6px;
    font-size: 0.85rem;
  }
  .body p.ref a {
    color: var(--accent-text);
    text-decoration: none;
  }
  .body p.ref a:hover {
    text-decoration: underline;
  }

  /* One column leaves the right of the shell open for the full height of the
     chain, which is a far better home for the texture than the sliver the old
     last row left over. */
  .mark-zone {
    position: absolute;
    top: -12px;
    bottom: -12px;
    /* Anchored to the chain's own cap, not a percentage: a percentage put the
       zone inside the text column as soon as the viewport narrowed. */
    left: 648px;
    width: 60vw;
    z-index: 0;
    /* Teal on near-white carries less than the same teal on navy, so light
       needs more of it to read as rivers rather than as a faint smudge. */
    opacity: 0.16;
    pointer-events: none;
    /* The network now runs the full height, so the ends are held off by a long
       soft fade rather than a hard stop: it should look like the basin carries
       on past the section, not like it was cropped. */
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 26%),
      linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0, 0, 0, 0.25) 7%,
        rgba(0, 0, 0, 0.75) 15%,
        #000 24%,
        #000 76%,
        rgba(0, 0, 0, 0.75) 85%,
        rgba(0, 0, 0, 0.25) 93%,
        transparent 100%
      );
    mask-image:
      linear-gradient(to right, transparent, #000 26%),
      linear-gradient(
        to bottom,
        transparent 0%,
        rgba(0, 0, 0, 0.25) 7%,
        rgba(0, 0, 0, 0.75) 15%,
        #000 24%,
        #000 76%,
        rgba(0, 0, 0, 0.75) 85%,
        rgba(0, 0, 0, 0.25) 93%,
        transparent 100%
      );
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .mark-zone {
      opacity: 0.14;
    }
  }
  :root[data-theme="dark"] .mark-zone {
    opacity: 0.14;
  }
  /* Below this the free column beside the 600px chain is too narrow to hold a
     lattice, and the texture reads as smudge rather than rivers. */
  @media (max-width: 1100px) {
    .mark-zone {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .stage {
      --rail: 44px;
      column-gap: 16px;
    }
    .node {
      font-size: 1.15rem;
    }
    .body {
      padding-top: 9px;
    }
    .body h3 {
      font-size: 1.08rem;
    }
  }

  /* The heading promises "your river" and the section had no way to reach one. */
  .go {
    margin-top: clamp(30px, 3.5vw, 42px);
  }
  .go a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-text);
    font-family: "Raleway", "Open Sans", system-ui, sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    text-decoration: none;
  }
  .go a:hover {
    text-decoration: underline;
  }
</style>
