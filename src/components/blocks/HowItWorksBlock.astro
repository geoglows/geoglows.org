---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, steps } = Astro.props as Extract<
  Block,
  { type: "howItWorks" }
>;
const pad = (index: number) => String(index + 1).padStart(2, "0");
---

<section class="block steps-flow">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} />
    <ol class="grid">
      {
        steps.map((step, index) => (
          <li class="step">
            <span class="node">{pad(index)}</span>
            <span class="rail" aria-hidden="true" />
            <div class="body">
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps-flow {
    padding-block: clamp(52px, 7vw, 96px);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 56px;
    row-gap: clamp(36px, 4vw, 52px);
  }
  .step {
    position: relative;
  }
  .node {
    position: relative;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 2px solid var(--color-amber);
    background: var(--surface-page);
    color: var(--color-amber);
    font-family: "Raleway", sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  /* Static connector: a track from each node to the next with an arrowhead
     pointing into it, so 01 -> 06 reads as one chain. No line motion. */
  .rail {
    position: absolute;
    top: 26px;
    left: 62px;
    right: -56px;
    height: 2px;
    background: rgba(255, 191, 0, 0.4);
  }
  .rail::after {
    content: "";
    position: absolute;
    right: -1px;
    top: -5px;
    width: 0;
    height: 0;
    border: 6px solid transparent;
    border-left-color: var(--color-amber);
    opacity: 0.7;
  }
  .step:nth-child(3n) .rail,
  .step:last-child .rail {
    display: none;
  }
  .body h3 {
    margin-top: 16px;
    font-size: 1.12rem;
  }
  .body p {
    margin-top: 8px;
    color: var(--text-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      column-gap: 0;
      row-gap: 4px;
    }
    /* Timeline: node in a left gutter, text indented beside it, and a vertical
       rail down the gutter connecting the nodes (never crossing the text). */
    .step {
      display: grid;
      grid-template-columns: 54px 1fr;
      column-gap: 20px;
      align-items: start;
      padding-bottom: 28px;
    }
    .node {
      grid-column: 1;
      grid-row: 1;
    }
    .body {
      grid-column: 2;
      grid-row: 1;
      padding-top: 10px;
    }
    .rail {
      top: 54px;
      bottom: 0;
      left: 26px;
      right: auto;
      width: 2px;
      height: auto;
    }
    .rail::after {
      display: none;
    }
    .step:nth-child(3n) .rail {
      display: block;
    }
    .step:last-child .rail {
      display: none;
    }
  }
</style>
