---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, steps } = Astro.props as Extract<
  Block,
  { type: "howItWorks" }
>;
const pad = (index: number) => String(index + 1).padStart(2, "0");
---

<section class="block steps-flow">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} />
    {/* The chain carries what each stage hands on, not the stage names: those
        are the headings below, and repeating them taught nothing. */}
    {
      steps.some((s) => s.token) && (
        <ol class="chain">
          {steps.map((step) => (
            <li class="stage">{step.token ?? step.title}</li>
          ))}
        </ol>
      )
    }
    <ol class="grid">
      {
        steps.map((step, index) => (
          <li class="step">
            <span class="node">{pad(index)}</span>
            <div class="body">
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps-flow {
    padding-block: clamp(52px, 7vw, 96px);
  }
  .chain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px 0;
    margin: 0 0 clamp(34px, 4vw, 48px);
    padding: 0;
    list-style: none;
  }
  .stage {
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-strong);
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
  }
  /* The connector is generated, so it can never fall out of step with the list. */
  .stage + .stage::before {
    content: "→";
    display: inline-block;
    margin: 0 10px 0 -2px;
    color: var(--accent-text);
    font-weight: 800;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* Six explain the chain in two clean rows; the seventh is the output they
       produce, so it takes the full width rather than sitting in a hole. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 56px;
    row-gap: clamp(36px, 4vw, 52px);
  }
  .step {
    position: relative;
  }
  .node {
    position: relative;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 2px solid var(--accent-strong);
    background: var(--surface-page);
    color: var(--accent-strong);
    font-family: "Raleway", sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .body h3 {
    margin-top: 16px;
    font-size: 1.12rem;
  }
  .body p {
    margin-top: 8px;
    color: var(--text-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      column-gap: 0;
      row-gap: 4px;
    }

    .step {
      display: grid;
      grid-template-columns: 54px 1fr;
      column-gap: 20px;
      align-items: start;
      padding-bottom: 28px;
    }
    .node {
      grid-column: 1;
      grid-row: 1;
    }
    .body {
      grid-column: 2;
      grid-row: 1;
      padding-top: 10px;
    }
  }

  .step:last-child {
    grid-column: 1 / -1;
    margin-top: 6px;
    padding-top: clamp(26px, 3vw, 34px);
    border-top: 2px solid var(--accent-text);
  }
  .step:last-child .body h3 {
    font-size: 1.24rem;
  }
  .step:last-child .body p {
    max-width: 62ch;
    font-size: 1.02rem;
  }

  @media (max-width: 720px) {
    /* Wrapped horizontally this read as a tag cloud with arrows stranded at the
       line ends, so it becomes a vertical chain. */
    .chain {
      display: grid;
      justify-items: start;
      gap: 4px;
    }
    .stage + .stage::before {
      content: "↓";
      display: block;
      margin: 2px 0 2px 14px;
    }
  }
</style>