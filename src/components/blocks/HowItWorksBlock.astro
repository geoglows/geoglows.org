---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";
import PipelineSchematic from "../ui/PipelineSchematic.astro";
import PipelineForecast from "../ui/PipelineForecast.astro";
import NetworkWatermark from "../ui/NetworkWatermark.astro";

const { eyebrow, heading, intro, steps, cta } = Astro.props as Extract<
  Block,
  { type: "howItWorks" }
>;
const pad = (index: number) => String(index + 1).padStart(2, "0");
---

<section class="block steps-flow">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} />
    <div class="flow">
      <div class="mark-zone"><NetworkWatermark /></div>
      <ol class="grid">
        {
          steps.map((step, index) => (
            <li class:list={["step", { wide: !!step.figure }]}>
              <span class="node">{pad(index)}</span>
              <div class="body">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                {step.figure === "network" && <PipelineSchematic />}
                {step.figure === "forecast" && <PipelineForecast />}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    {
      cta && (
        <p class="go">
          <a href={cta.href} target="_blank" rel="noopener">
            {cta.label} →
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .steps-flow {
    padding-block: clamp(52px, 7vw, 96px);
    /* The watermark bleeds past the shell; the section is what crops it. */
    overflow: hidden;
  }
  .flow {
    position: relative;
  }
  /* The 01/02 row leaves its third column empty. The texture lives there and
     nowhere else, so it never passes under a line of text. */
  .mark-zone {
    position: absolute;
    top: -18px;
    left: 67%;
    width: 62vw;
    height: 250px;
    z-index: 0;
    /* Teal on near-white carries less than the same teal on navy, so light
       needs more of it to read as rivers rather than as a faint smudge. */
    opacity: 0.13;
    pointer-events: none;
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 34%),
      linear-gradient(to bottom, #000 45%, transparent);
    mask-image:
      linear-gradient(to right, transparent, #000 34%),
      linear-gradient(to bottom, #000 45%, transparent);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .mark-zone {
      opacity: 0.075;
    }
  }
  :root[data-theme="dark"] .mark-zone {
    opacity: 0.075;
  }
  /* Below three columns there is no empty cell to put it in, and at this size
     it reads as smudge rather than rivers. */
  @media (max-width: 900px) {
    .mark-zone {
      display: none;
    }
  }
  .grid {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* Stages without a figure sit three-up; the two that carry one take the
       full row, which is what keeps figure and stage reading as one unit. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 56px;
    row-gap: clamp(36px, 4vw, 52px);
  }
  .step {
    position: relative;
  }
  .node {
    position: relative;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 2px solid var(--accent-strong);
    background: var(--surface-page);
    color: var(--accent-strong);
    font-family: "Raleway", sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .body h3 {
    margin-top: 16px;
    font-size: 1.12rem;
  }
  .body p {
    margin-top: 8px;
    color: var(--text-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      column-gap: 0;
      row-gap: 4px;
    }

    .step {
      display: grid;
      grid-template-columns: 54px 1fr;
      column-gap: 20px;
      align-items: start;
      padding-bottom: 28px;
    }
    .node {
      grid-column: 1;
      grid-row: 1;
    }
    .body {
      grid-column: 2;
      grid-row: 1;
      padding-top: 10px;
    }
  }

  .step.wide {
    grid-column: 1 / -1;
    margin-top: 6px;
    padding-top: clamp(26px, 3vw, 34px);
    border-top: 2px solid var(--accent-text);
  }
  .step.wide .body h3 {
    font-size: 1.24rem;
  }
  .step.wide .body p {
    max-width: 62ch;
    font-size: 1.02rem;
  }

  /* The heading promises "your river" and the section had no way to reach one. */
  .go {
    margin-top: clamp(30px, 3.5vw, 42px);
  }
  .go a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-text);
    font-family: "Raleway", "Open Sans", system-ui, sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    text-decoration: none;
  }
  .go a:hover {
    text-decoration: underline;
  }
</style>