---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, steps } = Astro.props as Extract<
  Block,
  { type: "howItWorks" }
>;
const pad = (index: number) => String(index + 1).padStart(2, "0");
---

<section class="block muted">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} />
    <div class="grid">
      {
        steps.map((step, index) => (
          <div class="step">
            <span class="num">{pad(index)}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .muted {
    background: var(--surface-muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 56px;
    row-gap: clamp(32px, 4vw, 48px);
  }
  .step {
    position: relative;
  }
  /* Flow connector: an arrow from each step to the next within a row, so the
     01 -> 06 sequence reads as a pipeline rather than a plain grid. */
  .step:not(:nth-child(3n)):not(:last-child)::after {
    content: "→";
    position: absolute;
    top: 4px;
    right: -37px;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--color-amber);
    opacity: 0.55;
  }
  .num {
    display: block;
    color: var(--color-amber);
    font-family: "Raleway", sans-serif;
    font-weight: 800;
    font-size: 2.4rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  h3 {
    margin-top: 10px;
    font-size: 1.2rem;
  }
  p {
    margin-top: 8px;
    color: var(--text-body);
    font-size: 0.95rem;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      column-gap: 0;
      row-gap: 40px;
    }
    /* Stacked: point the flow downward between every consecutive step. */
    .step:not(:nth-child(3n)):not(:last-child)::after,
    .step:nth-child(3n):not(:last-child)::after {
      content: "↓";
      top: auto;
      right: auto;
      left: 6px;
      bottom: -28px;
      font-size: 1.4rem;
    }
  }
</style>
