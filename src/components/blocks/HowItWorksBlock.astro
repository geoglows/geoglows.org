---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, steps } = Astro.props as Extract<
  Block,
  { type: "howItWorks" }
>;
const pad = (index: number) => String(index + 1).padStart(2, "0");
---

<section class="block steps-flow">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} />
    <ol class="grid">
      {
        steps.map((step, index) => (
          <li class="step">
            <span class="node">{pad(index)}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps-flow {
    padding-block: clamp(52px, 7vw, 96px);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 56px;
    row-gap: clamp(36px, 4vw, 52px);
  }
  .step {
    position: relative;
  }
  .node {
    position: relative;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 2px solid var(--color-amber);
    background: var(--surface-page);
    color: var(--color-amber);
    font-family: "Raleway", sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  /* Rail: a track that spans from each node to the next within a row, with a
     bright pulse that flows along it (water moving through the pipeline) and an
     arrowhead into the next node, so the 01 -> 06 sequence reads as a chain.
     The track itself draws in on reveal via the global .step::before rule. */
  .step::before {
    content: "";
    position: absolute;
    top: 26px;
    left: 60px;
    right: -56px;
    height: 2px;
    background-image:
      linear-gradient(90deg, rgba(255, 191, 0, 0.3), rgba(255, 191, 0, 0.3)),
      linear-gradient(90deg, transparent, rgba(255, 218, 110, 0.95), transparent);
    background-repeat: no-repeat;
    background-size:
      100% 100%,
      42% 100%;
    background-position:
      0 0,
      -42% 0;
  }
  .step::after {
    content: "";
    position: absolute;
    top: 21px;
    right: -56px;
    width: 0;
    height: 0;
    border: 6px solid transparent;
    border-left-color: var(--color-amber);
    opacity: 0.65;
  }
  .step:nth-child(3n)::before,
  .step:nth-child(3n)::after,
  .step:last-child::before,
  .step:last-child::after {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .step::before {
      animation: flow 2.4s linear infinite;
    }
  }
  @keyframes flow {
    to {
      background-position:
        0 0,
        142% 0;
    }
  }
  h3 {
    margin-top: 16px;
    font-size: 1.12rem;
  }
  p {
    margin-top: 8px;
    color: var(--text-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      column-gap: 0;
    }
    /* Stacked: a vertical rail links each node down to the next. */
    .step::before {
      top: 62px;
      bottom: -38px;
      left: 26px;
      right: auto;
      width: 2px;
      height: auto;
      background: rgba(255, 191, 0, 0.35);
      animation: none;
    }
    .step:nth-child(3n)::before {
      display: block;
    }
    .step:last-child::before {
      display: none;
    }
    .step::after {
      display: none;
    }
  }
</style>
