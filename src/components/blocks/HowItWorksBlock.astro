---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";
import NetworkWatermark from "../ui/NetworkWatermark.astro";

const { eyebrow, heading, intro, steps, cta } = Astro.props as Extract<
  Block,
  { type: "howItWorks" }
>;
const pad = (index: number) => String(index + 1).padStart(2, "0");

// Empty columns left in the final row. The watermark seats itself in them, so
// it is placed by the grid's own geometry rather than by a guessed height, and
// a stage count that fills the row cleanly gets no watermark at all.
const COLUMNS = 3;
const spare = (COLUMNS - (steps.length % COLUMNS)) % COLUMNS;
---

<section class="block steps-flow">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} />
    <ol class="grid">
      {
        steps.map((step, index) => (
          <li class="step">
            <span class="node">{pad(index)}</span>
            <div class="body">
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
            {spare > 0 && index === steps.length - 1 && (
              <div class="mark-zone"><NetworkWatermark /></div>
            )}
          </li>
        ))
      }
    </ol>
    {
      cta && (
        <p class="go">
          <a href={cta.href} target="_blank" rel="noopener">
            {cta.label} →
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .steps-flow {
    padding-block: clamp(52px, 7vw, 96px);
    /* The watermark bleeds past the shell; the section is what crops it. */
    overflow: hidden;
  }
  /* Anchored to the last stage and starting one column gap past it, so it
     fills exactly the columns that stage left empty and never passes under a
     line of text. Top and bottom follow that row, whatever height it takes. */
  .mark-zone {
    position: absolute;
    top: -16px;
    bottom: -16px;
    left: calc(100% + 56px);
    width: 68vw;
    z-index: -1;
    /* Teal on near-white carries less than the same teal on navy, so light
       needs more of it to read as rivers rather than as a faint smudge. */
    opacity: 0.13;
    pointer-events: none;
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 30%),
      linear-gradient(to bottom, transparent, #000 55%);
    mask-image:
      linear-gradient(to right, transparent, #000 30%),
      linear-gradient(to bottom, transparent, #000 55%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .mark-zone {
      opacity: 0.075;
    }
  }
  :root[data-theme="dark"] .mark-zone {
    opacity: 0.075;
  }
  /* Below three columns there is no empty cell to put it in, and at this size
     it reads as smudge rather than rivers. */
  @media (max-width: 900px) {
    .mark-zone {
      display: none;
    }
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 56px;
    row-gap: clamp(36px, 4vw, 52px);
  }
  .step {
    position: relative;
  }
  .node {
    position: relative;
    z-index: 1;
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 2px solid var(--accent-strong);
    background: var(--surface-page);
    color: var(--accent-strong);
    font-family: "Raleway", sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .body h3 {
    margin-top: 16px;
    font-size: 1.12rem;
  }
  .body p {
    margin-top: 8px;
    color: var(--text-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      column-gap: 0;
      row-gap: 4px;
    }

    .step {
      display: grid;
      grid-template-columns: 54px 1fr;
      column-gap: 20px;
      align-items: start;
      padding-bottom: 28px;
    }
    .node {
      grid-column: 1;
      grid-row: 1;
    }
    .body {
      grid-column: 2;
      grid-row: 1;
      padding-top: 10px;
    }
  }

  /* The heading promises "your river" and the section had no way to reach one. */
  .go {
    margin-top: clamp(30px, 3.5vw, 42px);
  }
  .go a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-text);
    font-family: "Raleway", "Open Sans", system-ui, sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    text-decoration: none;
  }
  .go a:hover {
    text-decoration: underline;
  }
</style>