---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";
import Icon from "../ui/Icon.astro";

const { eyebrow, heading, intro, background, items } = Astro.props as Extract<
  Block,
  { type: "dataAccess" }
>;
const external = (href: string) => /^https?:\/\//.test(href);
---

<section class:list={["block", { muted: background === "muted" }]}>
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <div class="grid">
      {
        items.map((item) => (
          <article class="card">
            <span class="glyph">
              <Icon name={item.icon} size={24} />
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            {item.links.length > 0 && (
              <div class="links">
                {item.links.map((link) => (
                  <a
                    href={link.href}
                    {...(external(link.href)
                      ? { target: "_blank", rel: "noopener" }
                      : {})}
                  >
                    {link.label} →
                  </a>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .muted {
    background: var(--surface-muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-page);
    box-shadow: var(--shadow-sm);
  }
  .glyph {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 11px;
    background: var(--surface-teal-wash);
    color: var(--accent-text);
    margin-bottom: 4px;
  }
  h3 {
    font-size: 1.12rem;
    color: var(--text-strong);
  }
  p {
    color: var(--text-body);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: auto;
    padding-top: 12px;
  }
  .links a {
    color: var(--accent-text);
    font-weight: 700;
    font-size: 0.86rem;
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }
</style>
