---
import type { Block } from "../../schemas/blocks";
import { isExternal } from "../../lib/links";
import SectionHeader from "../ui/SectionHeader.astro";
import Icon from "../ui/Icon.astro";

const { eyebrow, heading, intro, background, items } = Astro.props as Extract<
  Block,
  { type: "dataAccess" }
>;
---

<section class:list={["block data-access", { muted: background === "muted" }]}>
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <div class="grid">
      {
        items.map((item) => (
          <article class="card">
            <div class="top">
              <span class="glyph">
                <Icon name={item.icon} size={22} />
              </span>
              {item.tag && <span class="tag">{item.tag}</span>}
            </div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            {item.code && (
              <code class="snippet">
                <span class="prompt">$</span>
                {item.code}
              </code>
            )}
            {item.links.length > 0 && (
              <div class="links">
                {item.links.map((link) => (
                  <a
                    href={link.href}
                    {...(isExternal(link.href)
                      ? { target: "_blank", rel: "noopener" }
                      : {})}
                  >
                    {link.label} →
                  </a>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .muted {
    background: var(--surface-muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(258px, 100%), 1fr));
    gap: 18px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 11px;
    padding: 24px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-page);
    box-shadow: var(--shadow-sm);
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-text);
    box-shadow: var(--shadow-md);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .glyph {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: var(--surface-teal-wash);
    color: var(--accent-text);
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card:hover .glyph {
    transform: scale(1.08) rotate(-4deg);
  }
  .tag {
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-faint);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  h3 {
    font-size: 1.12rem;
    color: var(--text-strong);
  }
  p {
    color: var(--text-body);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .snippet {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    border-radius: 8px;
    background: var(--surface-alt);
    color: var(--text-strong);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    line-height: 1.3;
    overflow-x: auto;
    white-space: nowrap;
  }
  .snippet .prompt {
    color: var(--accent-text);
    font-weight: 700;
    user-select: none;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: auto;
    padding-top: 4px;
  }
  .links a {
    color: var(--accent-text);
    font-weight: 700;
    font-size: 0.86rem;
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-ready) .data-access .card {
      opacity: 0;
      transform: translateY(22px);
    }
    :global(.reveal-ready) .data-access.is-visible .card {
      opacity: 1;
      transform: none;
    }
    :global(.reveal-ready) .data-access.is-visible .card:nth-child(2) {
      transition-delay: 0.08s;
    }
    :global(.reveal-ready) .data-access.is-visible .card:nth-child(3) {
      transition-delay: 0.16s;
    }
    :global(.reveal-ready) .data-access.is-visible .card:nth-child(4) {
      transition-delay: 0.24s;
    }
  }
</style>
