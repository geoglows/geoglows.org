---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, tabs } = Astro.props as Extract<
  Block,
  { type: "resourceTabs" }
>;
const external = (href: string) => /^https?:\/\//.test(href);
---

<section class="block">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <ul class="grid">
      {
        tabs.map((tab) => (
          <li>
            <a
              class="tab"
              href={tab.href}
              target={external(tab.href) ? "_blank" : undefined}
              rel={external(tab.href) ? "noopener" : undefined}
            >
              <span class="label">{tab.label}<span class="arrow" aria-hidden="true">→</span></span>
              {tab.description && <span class="desc">{tab.description}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .tab {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-page);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .tab:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .tab:hover {
      transform: none;
    }
  }
  .label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    color: var(--text-strong);
    font-size: 1.1rem;
    font-weight: 800;
  }
  .arrow {
    color: var(--accent-text);
    transition: transform 0.16s ease;
  }
  .tab:hover .arrow {
    transform: translateX(4px);
  }
  .desc {
    color: var(--text-body);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
