---
import type { Block } from "../../schemas/blocks";
import { priorityAttrs } from "../../lib/image";
import GeoGlyph from "../site/GeoGlyph.astro";

const { eyebrow, heading, lede, image, imageAlt, statementLabel, statement, facts, background } =
  Astro.props as Extract<Block, { type: "identityStatement" }>;
const image_attrs = priorityAttrs(Astro.props.priority);
---

<section class:list={["block identity", { muted: background === "muted" }]}>
  <div class="shell">
    {
      eyebrow && (
        <p class="eyebrow">
          <GeoGlyph />
          {eyebrow}
        </p>
      )
    }
    <h2>{heading}</h2>
    <p class="lede">{lede}</p>

    {
      image && (
        <img
          class="band"
          src={image}
          alt={imageAlt ?? ""}
          width="1600"
          height="840"
          {...image_attrs}
        />
      )
    }

    {
      statement && (
        <figure class="statement">
          {statementLabel && <figcaption>{statementLabel}</figcaption>}
          <p>{statement}</p>
        </figure>
      )
    }

    {
      facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd>{f.text}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>

<style>
  .muted {
    background: var(--surface-muted);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--accent-text);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  h2 {
    max-width: 24ch;
    font-size: clamp(2rem, 3.9vw, 3.05rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }
  .lede {
    max-width: 62ch;
    margin-top: 22px;
    color: var(--text-body);
    font-size: clamp(1.02rem, 1.35vw, 1.2rem);
    line-height: 1.6;
  }

  /* The photo earns the full width here instead of being cropped into a
     column, which is what left the old two-column version half empty. */
  .band {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    margin-top: clamp(34px, 4.5vw, 56px);
    border-radius: var(--radius);
  }

  .statement {
    display: grid;
    grid-template-columns: minmax(140px, 200px) minmax(0, 1fr);
    gap: 10px clamp(24px, 4vw, 56px);
    margin: clamp(38px, 5vw, 64px) 0 0;
    padding-top: clamp(26px, 3vw, 34px);
    border-top: 2px solid var(--accent-text);
  }
  .statement figcaption {
    color: var(--accent-text);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-top: 6px;
  }
  .statement p {
    max-width: 48ch;
    color: var(--text-strong);
    font-family: "Raleway", "Open Sans", system-ui, sans-serif;
    font-size: clamp(1.18rem, 2vw, 1.62rem);
    font-weight: 800;
    line-height: 1.32;
    letter-spacing: -0.015em;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(212px, 1fr));
    gap: clamp(22px, 3vw, 38px);
    margin: clamp(40px, 5vw, 66px) 0 0;
  }
  .fact {
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .fact dt {
    color: var(--text-strong);
    font-family: "Raleway", "Open Sans", system-ui, sans-serif;
    font-size: 0.97rem;
    font-weight: 800;
    letter-spacing: -0.005em;
  }
  .fact dd {
    margin: 8px 0 0;
    color: var(--text-body);
    font-size: 0.89rem;
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .statement {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    /* A 21:9 crop collapses to a strip at phone widths. */
    .band {
      aspect-ratio: 3 / 2;
    }
  }
</style>
