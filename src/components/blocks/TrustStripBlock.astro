---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, cta, groups } = Astro.props as Extract<
  Block,
  { type: "trustStrip" }
>;
const hasHeader = Boolean(eyebrow || heading);
---

<section class="block trust">
  <div class:list={["shell", { "with-head": hasHeader }]}>
    {hasHeader && <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />}
    <div class="categories">
      {
        groups.map((group) => (
          <section class="group">
            {group.label && <h3 class="label">{group.label}</h3>}
            <ul class="logo-strip">
              {group.logos.map((logo) => {
                const body = logo.image ? (
                  <img
                    class:list={["logo", logo.emblem && "emblem"]}
                    src={logo.image}
                    alt={logo.name}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="wordmark">{logo.name}</span>
                );
                return (
                  <li class:list={["slot", { "slot-word": !logo.image }]}>
                    {logo.url ? (
                      <a href={logo.url} target="_blank" rel="noopener" aria-label={logo.name}>
                        {body}
                      </a>
                    ) : (
                      body
                    )}
                  </li>
                );
              })}
            </ul>
            {group.tail && <p class="tail">{group.tail}</p>}
          </section>
        ))
      }
    </div>
    {
      cta && (
        <p class="more">
          <a href={cta.href}>{cta.label} →</a>
        </p>
      )
    }
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(40px, 5vw, 64px);
  }

  /* One row per partner type: the label holds a fixed column on the left, the
     marks run along the right. Hairlines between rows give the section the
     structure a stacked list lacks, without turning it into a grid of boxes. */
  .categories {
    margin-top: clamp(24px, 3vw, 38px);
    border-top: 1px solid var(--border);
  }

  .group {
    display: grid;
    grid-template-columns: minmax(150px, 196px) 1fr;
    align-items: center;
    column-gap: clamp(20px, 3vw, 44px);
    row-gap: 12px;
    padding-block: clamp(20px, 2.4vw, 30px);
    border-bottom: 1px solid var(--border);
  }

  .label {
    margin: 0;
    align-self: center;
    color: var(--text-faint);
    font-family: inherit;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .logo-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 14px 10px;
  }

  /* The SERVIR hubs have no marks of their own. Rather than dress the names as
     buttons, they read as a set of tags attached to the SERVIR logo beside them:
     filled, borderless, and quieter than a logo so they support it rather than
     compete with it. */
  .wordmark {
    display: inline-flex;
    align-items: center;
    height: 38px;
    padding: 0 15px;
    border-radius: 999px;
    background: var(--surface-wash);
    color: var(--accent-text);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .slot-word a:hover .wordmark,
  .slot-word a:focus-visible .wordmark {
    background: var(--surface-teal-wash);
  }

  .tail {
    grid-column: 2;
    max-width: 62ch;
    margin: 0;
    color: var(--text-faint);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .group {
      grid-template-columns: 1fr;
      row-gap: 14px;
    }
    .tail {
      grid-column: 1;
    }
  }

  .more {
    margin-top: 36px;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent-text);
    font-weight: 800;
    text-decoration: none;
  }

  .slot {
    display: grid;
    place-items: center;
    width: 172px;
    height: 92px;
  }

  .slot-word {
    width: auto;
    height: auto;
  }


  .slot a {
    text-decoration: none;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 6px;
  }
  .slot a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .logo {
    max-height: 82px;
    max-width: 100%;
    width: auto;
    object-fit: contain;

    filter: var(--logo-tint);
    opacity: 0.78;
    transition: opacity 0.2s ease;
  }

  .logo.emblem {
    filter: var(--logo-emblem-tint);
  }
  .slot:hover .logo {
    opacity: 1;
  }
  .tail {
    color: var(--text-faint);
    font-size: 0.85rem;
    font-weight: 500;
    max-width: 44ch;
  }
  @media (max-width: 640px) {
    .logo-strip {
      gap: 32px 40px;
    }
    .slot {
      width: 128px;
      height: 48px;
    }
    .logo {
      max-height: 42px;
    }
  }
</style>
