---
import type { Block } from "../../schemas/blocks";

const { rows } = Astro.props as Extract<Block, { type: "trustStrip" }>;
---

<section class="block trust">
  <div class="shell">
    {
      rows.map((row) => (
        <div class="row">
          <span class="label">{row.label}</span>
          <span class="names">{row.names}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(28px, 4vw, 44px);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--border);
  }
  .row:first-child {
    border-top: none;
  }
  .label {
    flex: 0 0 auto;
    color: var(--text-faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .names {
    color: var(--text-body);
    font-size: 0.92rem;
  }
</style>
