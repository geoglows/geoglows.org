---
import type { Block } from "../../schemas/blocks";

const { logosLabel, logos, logosTail, rows } = Astro.props as Extract<
  Block,
  { type: "trustStrip" }
>;
---

<section class="block trust">
  <div class="shell">
    {
      logos.length > 0 && (
        <div class="funders">
          {logosLabel && <span class="label">{logosLabel}</span>}
          <ul class="logo-strip">
            {logos.map((f) => (
              <li>
                {f.url ? (
                  <a href={f.url} target="_blank" rel="noopener" aria-label={f.name}>
                    <img src={f.image} alt={f.name} loading="lazy" decoding="async" />
                  </a>
                ) : (
                  <img src={f.image} alt={f.name} loading="lazy" decoding="async" />
                )}
              </li>
            ))}
            {logosTail && <li class="tail">{logosTail}</li>}
          </ul>
        </div>
      )
    }
    {
      rows.map((row) => (
        <div class="row">
          <span class="label">{row.label}</span>
          <span class="names">{row.names}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(28px, 4vw, 44px);
  }
  .label {
    color: var(--text-faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .funders {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    padding: 18px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: var(--shadow-sm);
  }
  .funders .label {
    flex-shrink: 0;
    color: #55555a;
  }
  .logo-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(18px, 3vw, 34px);
  }
  .logo-strip li {
    display: flex;
    align-items: center;
  }
  .logo-strip img {
    height: 30px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.62;
    transition: filter 0.18s ease, opacity 0.18s ease;
  }
  .logo-strip a:hover img,
  .logo-strip li:hover img {
    filter: grayscale(0);
    opacity: 1;
  }
  .logo-strip .tail {
    color: #6a6a70;
    font-size: 0.82rem;
    font-weight: 500;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    margin-top: 12px;
    border-top: 1px solid var(--border);
  }
  .row:first-child {
    margin-top: 0;
  }
  .funders + .row {
    border-top: none;
    padding-top: 20px;
  }
  .names {
    color: var(--text-body);
    font-size: 0.92rem;
  }

  @media (max-width: 640px) {
    .funders {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>
