---
import type { Block } from "../../schemas/blocks";

const { groups } = Astro.props as Extract<Block, { type: "trustStrip" }>;
---

<section class="block trust">
  <div class="shell">
    <div class="board">
      {
        groups.map((group) => (
          <div class="group">
            <span class="label">{group.label}</span>
            <ul class="logo-strip">
              {group.logos.map((logo) => {
                const img = (
                  <img
                    class:list={["logo", logo.invert && "invert"]}
                    src={logo.image}
                    alt={logo.name}
                    loading="lazy"
                    decoding="async"
                  />
                );
                return (
                  <li>
                    {logo.url ? (
                      <a href={logo.url} target="_blank" rel="noopener" aria-label={logo.name}>
                        {img}
                      </a>
                    ) : (
                      img
                    )}
                  </li>
                );
              })}
              {group.tail && <li class="tail">{group.tail}</li>}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(28px, 4vw, 44px);
  }
  .board {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 6px 26px;
  }
  .group {
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
    padding: 20px 0;
    border-top: 1px solid #eceff1;
  }
  .group:first-child {
    border-top: none;
  }
  .label {
    flex: 0 0 auto;
    width: 92px;
    color: #55555a;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .logo-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(18px, 3vw, 32px);
    flex: 1;
  }
  .logo-strip li {
    display: flex;
    align-items: center;
  }
  .logo {
    height: 32px;
    width: auto;
    max-width: 130px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.6;
    transition: filter 0.18s ease, opacity 0.18s ease;
  }
  /* logos supplied as white/light artwork: render as a dark silhouette so they
     read on the white board */
  .logo.invert {
    filter: brightness(0);
    opacity: 0.55;
  }
  li:hover .logo {
    filter: grayscale(0);
    opacity: 1;
  }
  li:hover .logo.invert {
    filter: brightness(0);
    opacity: 1;
  }
  .tail {
    color: #6a6a70;
    font-size: 0.82rem;
    font-weight: 500;
    max-width: 46ch;
  }
  @media (max-width: 640px) {
    .group {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .label {
      width: auto;
    }
  }
</style>
