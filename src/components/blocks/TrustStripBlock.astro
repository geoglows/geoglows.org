---
import type { Block } from "../../schemas/blocks";

const { groups } = Astro.props as Extract<Block, { type: "trustStrip" }>;
---

<section class="block trust">
  <div class="shell">
    {
      groups.map((group) => (
        <div class="group">
          <span class="label">{group.label}</span>
          <ul class="logo-strip">
            {group.logos.map((logo) => {
              const img = (
                <img
                  class="logo"
                  src={logo.image}
                  alt={logo.name}
                  loading="lazy"
                  decoding="async"
                />
              );
              return (
                <li class="cell">
                  {logo.url ? (
                    <a href={logo.url} target="_blank" rel="noopener" aria-label={logo.name}>
                      {img}
                    </a>
                  ) : (
                    img
                  )}
                </li>
              );
            })}
            {group.tail && <li class="tail">{group.tail}</li>}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(30px, 4vw, 48px);
  }
  .group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(18px, 2.4vw, 26px);
  }
  .label {
    color: var(--text-faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .logo-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  /* White cards keep the original full-color logos legible on any background
     and give every logo an equal footprint regardless of its shape. */
  .cell {
    display: grid;
    place-items: center;
    width: 152px;
    height: 82px;
    padding: 16px 22px;
    border: 1px solid rgba(29, 29, 36, 0.08);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .cell:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  @media (prefers-reduced-motion: reduce) {
    .cell {
      transition: none;
    }
    .cell:hover {
      transform: none;
    }
  }
  .cell a {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 6px;
  }
  .cell a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .logo {
    max-height: 46px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }
  .tail {
    color: var(--text-faint);
    font-size: 0.85rem;
    font-weight: 500;
    max-width: 44ch;
  }
  @media (max-width: 640px) {
    .logo-strip {
      gap: 12px;
    }
    .cell {
      width: 132px;
      height: 72px;
    }
  }
</style>
