---
import type { Block } from "../../schemas/blocks";

const { groups } = Astro.props as Extract<Block, { type: "trustStrip" }>;
---

<section class="block trust">
  <div class="shell">
    {
      groups.map((group) => (
        <div class="group">
          <span class="label">{group.label}</span>
          <ul class="logo-strip">
            {group.logos.map((logo) => {
              const img = (
                <img
                  class:list={["logo", logo.invert && "invert"]}
                  src={logo.image}
                  alt={logo.name}
                  loading="lazy"
                  decoding="async"
                />
              );
              return (
                <li>
                  {logo.url ? (
                    <a href={logo.url} target="_blank" rel="noopener" aria-label={logo.name}>
                      {img}
                    </a>
                  ) : (
                    img
                  )}
                </li>
              );
            })}
            {group.tail && <li class="tail">{group.tail}</li>}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(30px, 4vw, 48px);
  }
  .group {
    display: flex;
    align-items: center;
    gap: clamp(18px, 3vw, 40px);
    flex-wrap: wrap;
    padding: 18px 0;
    border-top: 1px solid var(--border);
  }
  .group:first-child {
    border-top: none;
  }
  .label {
    flex: 0 0 auto;
    width: 96px;
    color: var(--text-faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .logo-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(20px, 3.2vw, 42px);
  }
  .logo-strip li {
    display: flex;
    align-items: center;
  }
  .logo {
    height: 30px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    filter: var(--logo-tint);
    opacity: 0.72;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }
  .logo.invert {
    filter: var(--logo-invert-tint);
  }
  li:hover .logo {
    opacity: 1;
  }
  .tail {
    color: var(--text-faint);
    font-size: 0.85rem;
    font-weight: 500;
    max-width: 44ch;
  }
  @media (max-width: 640px) {
    .group {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .label {
      width: auto;
    }
  }
</style>
