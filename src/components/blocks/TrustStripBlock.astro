---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, cta, groups } = Astro.props as Extract<
  Block,
  { type: "trustStrip" }
>;
const hasHeader = Boolean(eyebrow || heading);
---

<section class="block trust">
  <div class:list={["shell", { "with-head": hasHeader }]}>
    {hasHeader && <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />}
    <div class="categories">
      {
        groups.map((group, i) => (
          <section class:list={["group", { lead: i === 0 }]}>
            {group.label && <h3 class="label">{group.label}</h3>}
            <ul class="logo-strip">
              {group.logos.map((logo) => {
                const body = logo.image ? (
                  <img
                    class:list={["logo", logo.emblem && "emblem"]}
                    src={logo.image}
                    alt={logo.name}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="wordmark">{logo.name}</span>
                );
                return (
                  <li class:list={["slot", { "slot-word": !logo.image }]}>
                    {logo.url ? (
                      <a href={logo.url} target="_blank" rel="noopener" aria-label={logo.name}>
                        {body}
                      </a>
                    ) : (
                      body
                    )}
                  </li>
                );
              })}
            </ul>
            {group.tail && <p class="tail">{group.tail}</p>}
          </section>
        ))
      }
    </div>
    {
      cta && (
        <p class="more">
          <a href={cta.href}>{cta.label} →</a>
        </p>
      )
    }
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(40px, 5vw, 64px);
  }

  /* Categories sit side by side rather than stacking, so the section reads as a
     composition instead of a list. The first category spans the full width and
     carries larger marks: these are the bodies that convene the initiative. */
  .categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(258px, 1fr));
    column-gap: clamp(28px, 3.4vw, 56px);
    row-gap: clamp(34px, 4vw, 60px);
    margin-top: clamp(28px, 3.2vw, 44px);
  }

  .group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .group.lead {
    grid-column: 1 / -1;
    padding-bottom: clamp(26px, 3vw, 40px);
    border-bottom: 1px solid var(--border);
  }

  .label {
    margin: 0;
    color: var(--text-faint);
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
    text-align: left;
  }

  .group.lead .label {
    color: var(--accent-text);
  }

  .logo-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 18px 26px;
  }

  .group.lead .logo-strip {
    gap: 22px clamp(30px, 4vw, 58px);
  }

  /* A partner with no logo asset is still a partner. Rendering the name as a
     wordmark chip keeps the row deliberate instead of leaving a gap. */
  .wordmark {
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    height: 38px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-body);
    font-size: 0.83rem;
    font-weight: 700;
    white-space: nowrap;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .slot-word a:hover .wordmark,
  .slot-word a:focus-visible .wordmark {
    border-color: var(--accent);
    color: var(--accent-text);
  }

  .tail {
    max-width: 46ch;
    margin: 2px 0 0;
    color: var(--text-faint);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .more {
    margin-top: 36px;
  }
  .more a {
    color: var(--accent-text);
    font-weight: 800;
    text-decoration: none;
  }

  .slot {
    display: grid;
    place-items: center;
    width: 132px;
    height: 52px;
  }

  .slot-word {
    width: auto;
    height: auto;
  }

  .group.lead .slot {
    width: 172px;
    height: 68px;
  }

  .group.lead .logo {
    max-height: 58px;
  }
  .slot a {
    text-decoration: none;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 6px;
  }
  .slot a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .logo {
    max-height: 44px;
    max-width: 100%;
    width: auto;
    object-fit: contain;

    filter: var(--logo-tint);
    opacity: 0.78;
    transition: opacity 0.2s ease;
  }

  .logo.emblem {
    filter: var(--logo-emblem-tint);
  }
  .slot:hover .logo {
    opacity: 1;
  }
  .tail {
    color: var(--text-faint);
    font-size: 0.85rem;
    font-weight: 500;
    max-width: 44ch;
  }
  @media (max-width: 640px) {
    .logo-strip {
      gap: 32px 40px;
    }
    .slot {
      width: 128px;
      height: 48px;
    }
    .logo {
      max-height: 42px;
    }
  }
</style>
