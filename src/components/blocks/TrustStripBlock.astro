---
import type { Block } from "../../schemas/blocks";

const { groups } = Astro.props as Extract<Block, { type: "trustStrip" }>;
---

<section class="block trust">
  <div class="shell">
    {
      groups.map((group) => (
        <div class="group">
          <span class="label">{group.label}</span>
          <ul class="logo-strip">
            {group.logos.map((logo) => {
              const img = (
                <img
                  class:list={["logo", logo.emblem && "emblem"]}
                  src={logo.image}
                  alt={logo.name}
                  loading="lazy"
                  decoding="async"
                />
              );
              return (
                <li class="slot">
                  {logo.url ? (
                    <a href={logo.url} target="_blank" rel="noopener" aria-label={logo.name}>
                      {img}
                    </a>
                  ) : (
                    img
                  )}
                </li>
              );
            })}
            {group.tail && <li class="tail">{group.tail}</li>}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(30px, 4vw, 48px);
  }
  .group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(20px, 2.6vw, 30px);
  }
  .label {
    color: var(--text-faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .logo-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(28px, 3.4vw, 52px);
  }
  /* Each logo gets an equal invisible slot so mixed emblems and wordmarks
     read at a consistent size without any card behind them. */
  .slot {
    display: grid;
    place-items: center;
    width: 132px;
    height: 46px;
  }
  .slot a {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 6px;
  }
  .slot a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .logo {
    max-height: 42px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
    /* Monochrome: tasteful grayscale on the light page, bold light marks on
       the dark page (see --logo-tint per theme in tokens.css). */
    filter: var(--logo-tint);
    opacity: 0.78;
    transition: opacity 0.2s ease;
  }
  /* Filled multi-tone seals keep their detail instead of flattening to a disc. */
  .logo.emblem {
    filter: var(--logo-emblem-tint);
  }
  .slot:hover .logo {
    opacity: 1;
  }
  .tail {
    color: var(--text-faint);
    font-size: 0.85rem;
    font-weight: 500;
    max-width: 44ch;
  }
  @media (max-width: 640px) {
    .logo-strip {
      gap: 28px;
    }
    .slot {
      width: 108px;
      height: 40px;
    }
    .logo {
      max-height: 36px;
    }
  }
</style>
