---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, cta, groups } = Astro.props as Extract<
  Block,
  { type: "trustStrip" }
>;
const hasHeader = Boolean(eyebrow || heading);
---

<section class="block trust">
  <div class:list={["shell", { "with-head": hasHeader }]}>
    {hasHeader && <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />}
    {
      groups.map((group) => (
        <div class="group">
          {!hasHeader && group.label && <span class="label">{group.label}</span>}
          <ul class="logo-strip">
            {group.logos.map((logo) => {
              const img = (
                <img
                  class:list={["logo", logo.emblem && "emblem"]}
                  src={logo.image}
                  alt={logo.name}
                  loading="lazy"
                  decoding="async"
                />
              );
              return (
                <li class="slot">
                  {logo.url ? (
                    <a href={logo.url} target="_blank" rel="noopener" aria-label={logo.name}>
                      {img}
                    </a>
                  ) : (
                    img
                  )}
                </li>
              );
            })}
            {group.tail && <li class="tail">{group.tail}</li>}
          </ul>
        </div>
      ))
    }
    {
      cta && (
        <p class="more">
          <a href={cta.href}>{cta.label} →</a>
        </p>
      )
    }
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(40px, 5vw, 64px);
  }
  .group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(28px, 3.4vw, 42px);
  }
  .label {
    color: var(--text-faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.3;
    text-align: center;
  }
  .logo-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(36px, 4vw, 68px);
    /* Cap the row so it settles to ~4 logos per row, then centers. */
    max-width: 940px;
  }
  /* When the strip has its own header (e.g. a Partners section), left-align it
     like a normal section and let the logos fill a tidy grid. */
  .with-head .group {
    align-items: stretch;
  }
  .with-head .logo-strip {
    justify-content: flex-start;
    max-width: none;
    gap: clamp(28px, 3vw, 48px) clamp(16px, 3vw, 40px);
  }
  .with-head .slot {
    width: 150px;
  }
  .more {
    margin-top: 36px;
  }
  .more a {
    color: var(--accent-text);
    font-weight: 800;
    text-decoration: none;
  }
  /* Each logo gets an equal invisible slot so mixed emblems and wordmarks
     read at a consistent size without any card behind them. */
  .slot {
    display: grid;
    place-items: center;
    width: 168px;
    height: 62px;
  }
  .slot a {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 6px;
  }
  .slot a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .logo {
    max-height: 54px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
    /* Monochrome: tasteful grayscale on the light page, bold light marks on
       the dark page (see --logo-tint per theme in tokens.css). */
    filter: var(--logo-tint);
    opacity: 0.78;
    transition: opacity 0.2s ease;
  }
  /* Filled multi-tone seals keep their detail instead of flattening to a disc. */
  .logo.emblem {
    filter: var(--logo-emblem-tint);
  }
  .slot:hover .logo {
    opacity: 1;
  }
  .tail {
    color: var(--text-faint);
    font-size: 0.85rem;
    font-weight: 500;
    max-width: 44ch;
  }
  @media (max-width: 640px) {
    .logo-strip {
      gap: 32px 40px;
    }
    .slot {
      width: 128px;
      height: 48px;
    }
    .logo {
      max-height: 42px;
    }
  }
</style>
