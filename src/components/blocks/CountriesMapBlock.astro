---
import { createRequire } from "module";
import { geoEquirectangular, geoPath } from "d3-geo";
import { feature } from "topojson-client";
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, note, points, projects, directoryHeading, directoryIntro, cta } =
  Astro.props as Extract<Block, { type: "countriesMap" }>;

const slug = (s: string) =>
  "project-" + s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

const require = createRequire(import.meta.url);
const topo = require("world-atlas/countries-110m.json");
const countries = feature(topo, topo.objects.countries);

// The deployments span 215 deg of longitude but only 71 of latitude. Fitting the
// whole globe left 74% of the frame as empty ocean and Antarctica and pushed the
// Central America pins to 6.9px apart, closer than the dots are wide. Fitting the
// inhabited band instead makes the populated area 2.53x larger at the same width.
const LNG0 = -102;
const LNG1 = 113;
const LAT0 = -25;
const LAT1 = 46;
const W = 1000;
const H = Math.round((W * (LAT1 - LAT0)) / (LNG1 - LNG0));
// fitSize() cannot express this: it measures a polygon's edges as great circles,
// which bulge poleward and inflate the bounds back to the whole globe. The
// equirectangular projection is linear in lon/lat, so the fit is exact by hand.
const RAD = Math.PI / 180;
const k = W / ((LNG1 - LNG0) * RAD);
const projection = geoEquirectangular()
  .scale(k)
  .translate([-k * LNG0 * RAD, k * LAT1 * RAD]);
const worldPath = geoPath(projection)(countries) ?? "";
const pins = points
  .map((pt) => {
    const xy = projection([pt.lng, pt.lat]);
    return xy
      ? {
          country: pt.country,
          pos: pt.pos ?? "top",
          xPct: (xy[0] / W) * 100,
          yPct: (xy[1] / H) * 100,
        }
      : null;
  })
  .filter(Boolean) as {
  country: string;
  pos: string;
  xPct: number;
  yPct: number;
}[];
---

<section class="block countries">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <div class="map-wrap">
      <div class="map-frame">
        <svg
          viewBox={`0 0 ${W} ${H}`}
          class="map"
          role="img"
          aria-label="World map showing countries with documented GEOGLOWS deployments"
        >
          <path d={worldPath} class="world" />
        </svg>
        <div class="pins">
          {
            pins.map((p) => (
              <a
                class="pin pin-link"
                style={`left:${p.xPct}%;top:${p.yPct}%`}
                href={`#${slug(p.country)}`}
              >
                <span class="dot" />
                <span class:list={["lbl", `lbl-${p.pos}`]}>{p.country}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
    {note && <p class="note">{note}</p>}
    {
      projects.length > 0 && (
        <div class="directory" data-directory>
          {directoryHeading && <h3 class="dir-head">{directoryHeading}</h3>}
          {directoryIntro && <p class="dir-intro">{directoryIntro}</p>}
          <div class="grid">
          {projects.map((pr) => (
            <details class="project" id={slug(pr.country)}>
              <summary>
                <span class="who">
                  <span class="name">{pr.country}</span>
                  <span class="status">{pr.status}</span>
                </span>
                <span class="partner">{pr.partner}</span>
                <span class="teaser">{pr.result}</span>
                <span class="chev" aria-hidden="true" />
              </summary>
              <dl class="detail">
                <div>
                  <dt>Challenge</dt>
                  <dd>{pr.challenge}</dd>
                </div>
                <div>
                  <dt>GEOGLOWS application</dt>
                  <dd>{pr.application}</dd>
                </div>
                <div class="res">
                  <dt>Result</dt>
                  <dd>
                    {pr.result}
                    {pr.href && (
                      <>
                        {" "}
                        <a class="src" href={pr.href} target="_blank" rel="noopener">
                          Read more →
                        </a>
                      </>
                    )}
                  </dd>
                </div>
              </dl>
            </details>
          ))}
          </div>
        </div>
      )
    }
    {
      cta && (
        <p class="all">
          <a href={cta.href}>{cta.label} →</a>
        </p>
      )
    }
  </div>
</section>

<script>
  // The cards open and close on their own, so nothing here is required to read
  // the directory. This only keeps one card open at a time and lets a map
  // marker open its card.
  document.querySelectorAll("[data-directory]").forEach((dir) => {
    const cards = [...dir.querySelectorAll("details.project")];
    if (!cards.length) return;
    const pins = [...document.querySelectorAll(".pin-link")];

    const sync = () =>
      pins.forEach((pin) =>
        pin.classList.toggle(
          "is-active",
          cards.some((c) => c.open && "#" + c.id === pin.getAttribute("href")),
        ),
      );

    cards.forEach((card) =>
      card.addEventListener("toggle", () => {
        if (card.open) cards.forEach((other) => other !== card && (other.open = false));
        sync();
      }),
    );

    const openFromHash = (scroll) => {
      if (!location.hash) return;
      const card = cards.find((c) => "#" + c.id === location.hash);
      if (!card) return;
      card.open = true;
      if (scroll) card.scrollIntoView({ block: "center" });
    };
    window.addEventListener("hashchange", () => openFromHash(true));
    openFromHash(false);
    sync();
  });
</script>

<style>

  .countries {
    --map-ocean: #e7ecf0;
    --map-land: #d3dbe1;
    --map-border: #ffffff;
    --map-pin: var(--color-teal-green);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .countries {
      --map-ocean: #101b28;
      --map-land: #263749;
      --map-border: #101b28;
      --map-pin: #4fb3a4;
    }
  }
  :global(:root[data-theme="dark"]) .countries {
    --map-ocean: #101b28;
    --map-land: #263749;
    --map-border: #101b28;
    --map-pin: #4fb3a4;
  }
  :global(:root[data-theme="light"]) .countries {
    --map-ocean: #e7ecf0;
    --map-land: #d3dbe1;
    --map-border: #ffffff;
    --map-pin: var(--color-teal-green);
  }

  .map-wrap {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--map-ocean);
    padding: clamp(10px, 2vw, 20px);
  }
  .map-frame {
    position: relative;
  }
  .map {
    width: 100%;
    height: auto;
    display: block;
  }
  .world {
    fill: var(--map-land);
    stroke: var(--map-border);
    stroke-width: 0.6;
    stroke-linejoin: round;
  }

  .pins {
    position: absolute;
    inset: 0;
  }

  /* 22 markers cannot all carry a permanent label without colliding, so the
     dot is always visible and the name appears on hover, tap or focus. */
  /* The tightest pair sits 11.5px apart, so a 28px hit box swallowed its
     neighbour: aiming at Guatemala selected El Salvador. 16px keeps each dot's
     centre its own: that pair is 6.8px apart horizontally and 8.8px vertically,
     so a 16px box still overlapped by a pixel and :hover lifted the wrong pin
     on top. The chip rail is the accessible full-size control. */
  .pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 12px;
    height: 12px;
    transform: translate(-50%, -50%);
    text-decoration: none;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--map-pin);
    border: 2px solid var(--surface-page);
    box-shadow: 0 1px 4px rgba(15, 23, 32, 0.45);
    transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pin-link.is-active .dot {
    transform: scale(1.5);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--map-pin) 34%, transparent);
  }
  .pin:hover,
  .pin:focus {
    z-index: 5;
  }
  .pin:hover .dot,
  .pin:focus .dot {
    transform: scale(1.35);
  }
  .pin-link:focus-visible {
    outline: 2px solid var(--color-amber);
    outline-offset: 2px;
    border-radius: 50%;
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      transition: none;
    }
  }
  .lbl {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.14s ease;
    z-index: 6;
    padding: 2px 7px;
    border-radius: 6px;
    background: var(--surface-page);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    color: var(--text-strong);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  /* :focus as well as :focus-visible, so the name shows however focus arrives. */
  .pin:hover .lbl,
  .pin:focus .lbl,
  .pin:focus-visible .lbl {
    opacity: 1;
  }
  .lbl-top {
    bottom: calc(100% - 4px);
    left: 50%;
    transform: translateX(-50%);
  }
  .lbl-bottom {
    top: calc(100% - 4px);
    left: 50%;
    transform: translateX(-50%);
  }
  .lbl-left {
    right: calc(100% - 2px);
    top: 50%;
    transform: translateY(-50%);
  }
  .lbl-right {
    left: calc(100% - 2px);
    top: 50%;
    transform: translateY(-50%);
  }
  .note {
    margin-top: 14px;
    color: var(--text-faint);
    font-size: 0.9rem;
  }
  .all {
    margin-top: 20px;
  }
  .all a {
    color: var(--accent-text);
    font-weight: 800;
    text-decoration: none;
  }
  @media (max-width: 640px) {
    .lbl {
      font-size: 0.58rem;
      padding: 1px 5px;
    }
  }

  /* The definitive record: one row per documented project, country and status
     on the left, the six-field record on the right. */
  .directory {
    margin-top: clamp(44px, 5.5vw, 74px);
  }
  .dir-head {
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    letter-spacing: -0.01em;
  }
  .dir-intro {
    max-width: 66ch;
    margin-top: 10px;
    color: var(--text-body);
    font-size: 0.97rem;
    line-height: 1.6;
  }
  /* A directory of discrete records is what cards are actually for. The face
     carries the four things worth scanning; the record itself opens in place and
     takes the full row, so the grid rhythm breaks rather than repeating. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
    margin-top: 20px;
  }
  .project {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-page);
    scroll-margin-top: 90px;
    transition: border-color 0.16s ease;
  }
  .project:hover {
    border-color: var(--accent-text);
  }
  .project[open] {
    grid-column: 1 / -1;
    border-color: var(--accent-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .project {
      transition: none;
    }
  }
  summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18px;
    gap: 9px 14px;
    padding: 18px 18px 17px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: 2px solid var(--color-amber);
    outline-offset: 3px;
    border-radius: var(--radius);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .name {
    font-family: "Raleway", "Open Sans", system-ui, sans-serif;
    font-size: 1.12rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--text-strong);
  }
  .partner,
  .teaser {
    grid-column: 1 / -1;
  }
  .partner:empty {
    display: none;
  }
  summary {
    align-content: start;
  }
  .teaser {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--text-body);
    font-size: 0.86rem;
    line-height: 1.5;
  }
  /* The open record repeats it in full, so the teaser stands down. */
  .project[open] .teaser {
    display: none;
  }
  .project[open] .name {
    font-size: 1.3rem;
  }
  /* The chevron rotates; nothing in the layout box animates. */
  .chev {
    /* Pinned to the first row beside the name. Left to flow it landed under the
       teaser on a line of its own, costing a row of height on every card. */
    grid-row: 1;
    grid-column: 2;
    justify-self: end;
    align-self: start;
    margin-top: 9px;
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--text-faint);
    border-bottom: 2px solid var(--text-faint);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project[open] .chev {
    transform: rotate(-135deg) translate(-3px, -3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .chev {
      transition: none;
    }
  }
  .status {
    display: inline-block;
    padding: 3px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--accent-text);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .partner {
    color: var(--text-faint);
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .detail {
    padding: 2px 18px 20px;
    display: grid;
    /* Two even columns: auto-fit opened a third that only ever sat empty. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px clamp(22px, 3vw, 40px);
    margin: 0;
  }
  .detail .res {
    grid-column: 1 / -1;
  }
  .detail dt {
    color: var(--text-faint);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .detail dd {
    margin: 5px 0 0;
    color: var(--text-body);
    font-size: 0.89rem;
    line-height: 1.55;
  }
  .detail .res dd {
    color: var(--text-strong);
  }
  .src {
    color: var(--accent-text);
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    summary {
      grid-template-columns: minmax(0, 1fr) 18px;
      align-items: start;
    }
    .partner {
      grid-column: 1 / 2;
      text-align: left;
    }
    .detail {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 899px) {
    /* Hover labels cannot fire on touch, and edge pins pushed them past the
       viewport, which gave the page a horizontal scroll. Tapping a pin opens
       the record, which names the country anyway. */
    .lbl {
      display: none;
    }
  }
</style>