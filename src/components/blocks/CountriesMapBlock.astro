---
import { createRequire } from "module";
import { geoEquirectangular, geoPath } from "d3-geo";
import { feature } from "topojson-client";
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, note, points, cta } = Astro.props as Extract<
  Block,
  { type: "countriesMap" }
>;

// Build-time only: read the simplified land outline and project it (and the
// pins) with the same equirectangular projection so markers line up exactly.
const require = createRequire(import.meta.url);
const topo = require("world-atlas/land-110m.json");
const land = feature(topo, topo.objects.land);

const W = 1000;
const H = 500;
const projection = geoEquirectangular().fitSize([W, H], { type: "Sphere" });
const landPath = geoPath(projection)(land) ?? "";
const pins = points
  .map((pt) => {
    const xy = projection([pt.lng, pt.lat]);
    return xy
      ? { country: pt.country, xPct: (xy[0] / W) * 100, yPct: (xy[1] / H) * 100 }
      : null;
  })
  .filter(Boolean) as { country: string; xPct: number; yPct: number }[];
---

<section class="block countries">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <div class="map-wrap">
      <div class="map-frame">
        <svg
          viewBox={`0 0 ${W} ${H}`}
          class="map"
          role="img"
          aria-label="World map showing countries with documented GEOGLOWS deployments"
        >
          <path d={landPath} class="land" />
        </svg>
        <div class="pins">
          {
            pins.map((p) => (
              <span
                class="pin"
                style={`left:${p.xPct}%;top:${p.yPct}%`}
                title={p.country}
              >
                <span class="lbl">{p.country}</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>
    {note && <p class="note">{note}</p>}
    {
      cta && (
        <p class="all">
          <a href={cta.href}>{cta.label} →</a>
        </p>
      )
    }
  </div>
</section>

<style>
  /* Theme-tuned map palette: land reads clearly against the ocean in both
     modes without going garish. */
  .countries {
    --map-ocean: #e7ecf0;
    --map-land: #cfd8df;
    --map-stroke: #bcc7cf;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .countries {
      --map-ocean: #101b28;
      --map-land: #27394c;
      --map-stroke: #33475b;
    }
  }
  :global(:root[data-theme="dark"]) .countries {
    --map-ocean: #101b28;
    --map-land: #27394c;
    --map-stroke: #33475b;
  }
  :global(:root[data-theme="light"]) .countries {
    --map-ocean: #e7ecf0;
    --map-land: #cfd8df;
    --map-stroke: #bcc7cf;
  }

  .map-wrap {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--map-ocean);
    padding: clamp(10px, 2vw, 20px);
  }
  .map-frame {
    position: relative;
  }
  .map {
    width: 100%;
    height: auto;
    display: block;
  }
  .land {
    fill: var(--map-land);
    stroke: var(--map-stroke);
    stroke-width: 0.5;
  }

  /* HTML pin overlay: real stacking, so a hovered label sits above every
     other pin instead of being painted behind later ones. */
  .pins {
    position: absolute;
    inset: 0;
  }
  .pin {
    position: absolute;
    width: 12px;
    height: 12px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-amber);
    box-shadow: 0 0 0 5px rgba(255, 191, 0, 0.2);
    transition: box-shadow 0.15s ease;
  }
  .pin:hover,
  .pin:focus-visible {
    z-index: 5;
    box-shadow: 0 0 0 6px rgba(255, 191, 0, 0.32);
    outline: none;
  }
  .lbl {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 9px;
    border-radius: 7px;
    background: var(--surface-page);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    color: var(--text-strong);
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s ease;
  }
  .pin:hover .lbl,
  .pin:focus-visible .lbl {
    opacity: 1;
  }
  .note {
    margin-top: 14px;
    color: var(--text-faint);
    font-size: 0.9rem;
  }
  .all {
    margin-top: 20px;
  }
  .all a {
    color: var(--accent-text);
    font-weight: 800;
    text-decoration: none;
  }
</style>
