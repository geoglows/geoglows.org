---
import { createRequire } from "module";
import { geoEquirectangular, geoPath } from "d3-geo";
import { feature } from "topojson-client";
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, note, points, projects, directoryHeading, directoryIntro, cta } =
  Astro.props as Extract<Block, { type: "countriesMap" }>;

const slug = (s: string) =>
  "project-" + s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
// A pin only becomes a link when the directory actually holds that country.
const documented = new Set(projects.map((pr) => pr.country));

const require = createRequire(import.meta.url);
const topo = require("world-atlas/countries-110m.json");
const countries = feature(topo, topo.objects.countries);

const W = 1000;
const H = 500;
const projection = geoEquirectangular().fitSize([W, H], { type: "Sphere" });
const worldPath = geoPath(projection)(countries) ?? "";
const pins = points
  .map((pt) => {
    const xy = projection([pt.lng, pt.lat]);
    return xy
      ? {
          country: pt.country,
          pos: pt.pos ?? "top",
          xPct: (xy[0] / W) * 100,
          yPct: (xy[1] / H) * 100,
        }
      : null;
  })
  .filter(Boolean) as {
  country: string;
  pos: string;
  xPct: number;
  yPct: number;
}[];
---

<section class="block countries">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <div class="map-wrap">
      <div class="map-frame">
        <svg
          viewBox={`0 0 ${W} ${H}`}
          class="map"
          role="img"
          aria-label="World map showing countries with documented GEOGLOWS deployments"
        >
          <path d={worldPath} class="world" />
        </svg>
        <div class="pins">
          {
            pins.map((p) =>
              documented.has(p.country) ? (
                <a
                  class="pin pin-link"
                  style={`left:${p.xPct}%;top:${p.yPct}%`}
                  href={`#${slug(p.country)}`}
                >
                  <span class="dot" />
                  <span class:list={["lbl", `lbl-${p.pos}`]}>{p.country}</span>
                </a>
              ) : (
                <span class="pin" style={`left:${p.xPct}%;top:${p.yPct}%`}>
                  <span class="dot" />
                  <span class:list={["lbl", `lbl-${p.pos}`]}>{p.country}</span>
                </span>
              ),
            )
          }
        </div>
      </div>
    </div>
    {note && <p class="note">{note}</p>}
    {
      projects.length > 0 && (
        <div class="directory">
          {directoryHeading && <h3 class="dir-head">{directoryHeading}</h3>}
          {directoryIntro && <p class="dir-intro">{directoryIntro}</p>}
          {projects.map((pr) => (
            <details class="project" id={slug(pr.country)}>
              <summary>
                <span class="who">
                  <span class="name">{pr.country}</span>
                  <span class="status">{pr.status}</span>
                </span>
                <span class="partner">{pr.partner}</span>
                <span class="chev" aria-hidden="true" />
              </summary>
              <dl class="detail">
                <div>
                  <dt>Challenge</dt>
                  <dd>{pr.challenge}</dd>
                </div>
                <div>
                  <dt>GEOGLOWS application</dt>
                  <dd>{pr.application}</dd>
                </div>
                <div class="res">
                  <dt>Result</dt>
                  <dd>
                    {pr.result}
                    {pr.href && (
                      <>
                        {" "}
                        <a class="src" href={pr.href} target="_blank" rel="noopener">
                          Read more →
                        </a>
                      </>
                    )}
                  </dd>
                </div>
              </dl>
            </details>
          ))}
        </div>
      )
    }
    {
      cta && (
        <p class="all">
          <a href={cta.href}>{cta.label} →</a>
        </p>
      )
    }
  </div>
</section>

<script>
  // Arriving from a map pin should land on an open record. Without JS the row
  // is still reachable, just closed, so this is enhancement only.
  const openTarget = () => {
    if (!location.hash) return;
    const el = document.querySelector(location.hash);
    if (el instanceof HTMLDetailsElement && !el.open) {
      el.open = true;
      el.scrollIntoView();
    }
  };
  openTarget();
  window.addEventListener("hashchange", openTarget);
</script>

<style>

  .countries {
    --map-ocean: #e7ecf0;
    --map-land: #d3dbe1;
    --map-border: #ffffff;
    --map-pin: #7d93a5;
    --map-pin-live: var(--color-teal-green);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .countries {
      --map-ocean: #101b28;
      --map-land: #263749;
      --map-border: #101b28;
      --map-pin: #6c8296;
      --map-pin-live: #4fb3a4;
    }
  }
  :global(:root[data-theme="dark"]) .countries {
    --map-ocean: #101b28;
    --map-land: #263749;
    --map-border: #101b28;
    --map-pin: #6c8296;
    --map-pin-live: #4fb3a4;
  }
  :global(:root[data-theme="light"]) .countries {
    --map-ocean: #e7ecf0;
    --map-land: #d3dbe1;
    --map-border: #ffffff;
    --map-pin: #7d93a5;
    --map-pin-live: var(--color-teal-green);
  }

  .map-wrap {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--map-ocean);
    padding: clamp(10px, 2vw, 20px);
  }
  .map-frame {
    position: relative;
  }
  .map {
    width: 100%;
    height: auto;
    display: block;
  }
  .world {
    fill: var(--map-land);
    stroke: var(--map-border);
    stroke-width: 0.6;
    stroke-linejoin: round;
  }

  .pins {
    position: absolute;
    inset: 0;
  }

  /* 22 markers cannot all carry a permanent label without colliding, so the
     dot is always visible and the name appears on hover, tap or focus. */
  .pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    transform: translate(-50%, -50%);
    text-decoration: none;
  }
  .dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--map-pin);
    border: 2px solid var(--surface-page);
    box-shadow: 0 1px 4px rgba(15, 23, 32, 0.45);
    transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pin-link .dot {
    background: var(--map-pin-live);
  }
  .pin:hover,
  .pin:focus {
    z-index: 5;
  }
  .pin:hover .dot,
  .pin:focus .dot {
    transform: scale(1.35);
  }
  .pin-link:focus-visible {
    outline: 2px solid var(--color-amber);
    outline-offset: 2px;
    border-radius: 50%;
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      transition: none;
    }
  }
  .lbl {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.14s ease;
    z-index: 6;
    padding: 2px 7px;
    border-radius: 6px;
    background: var(--surface-page);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    color: var(--text-strong);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  /* :focus as well as :focus-visible, so the name shows however focus arrives. */
  .pin:hover .lbl,
  .pin:focus .lbl,
  .pin:focus-visible .lbl {
    opacity: 1;
  }
  .lbl-top {
    bottom: calc(100% - 4px);
    left: 50%;
    transform: translateX(-50%);
  }
  .lbl-bottom {
    top: calc(100% - 4px);
    left: 50%;
    transform: translateX(-50%);
  }
  .lbl-left {
    right: calc(100% - 2px);
    top: 50%;
    transform: translateY(-50%);
  }
  .lbl-right {
    left: calc(100% - 2px);
    top: 50%;
    transform: translateY(-50%);
  }
  .note {
    margin-top: 14px;
    color: var(--text-faint);
    font-size: 0.9rem;
  }
  .all {
    margin-top: 20px;
  }
  .all a {
    color: var(--accent-text);
    font-weight: 800;
    text-decoration: none;
  }
  @media (max-width: 640px) {
    .lbl {
      font-size: 0.58rem;
      padding: 1px 5px;
    }
  }

  /* The definitive record: one row per documented project, country and status
     on the left, the six-field record on the right. */
  .directory {
    margin-top: clamp(44px, 5.5vw, 74px);
  }
  .dir-head {
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    letter-spacing: -0.01em;
  }
  .dir-intro {
    max-width: 66ch;
    margin-top: 10px;
    color: var(--text-body);
    font-size: 0.97rem;
    line-height: 1.6;
  }
  /* 15 full records ran to 3.7 screens. The record is unchanged; only the
     Challenge/Application/Result detail is folded away until asked for. */
  .project {
    border-top: 1px solid var(--border);
    scroll-margin-top: 90px;
  }
  .project:first-of-type {
    border-top-width: 2px;
    border-top-color: var(--accent-text);
  }
  .project:last-of-type {
    border-bottom: 1px solid var(--border);
  }
  summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 18px;
    align-items: center;
    gap: 10px clamp(16px, 2.4vw, 32px);
    min-height: 56px;
    padding: 9px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover .name,
  .project[open] .name {
    color: var(--accent-text);
  }
  summary:focus-visible {
    outline: 2px solid var(--color-amber);
    outline-offset: 3px;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .name {
    font-family: "Raleway", "Open Sans", system-ui, sans-serif;
    font-size: 1.12rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--text-strong);
  }
  /* The chevron rotates; nothing in the layout box animates. */
  .chev {
    justify-self: end;
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--text-faint);
    border-bottom: 2px solid var(--text-faint);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project[open] .chev {
    transform: rotate(-135deg) translate(-3px, -3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .chev {
      transition: none;
    }
  }
  .status {
    display: inline-block;
    padding: 3px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--accent-text);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .partner {
    color: var(--text-faint);
    font-size: 0.83rem;
    line-height: 1.45;
    text-align: right;
  }
  .detail {
    padding: 2px 0 clamp(22px, 2.6vw, 30px);
    display: grid;
    /* Two even columns: auto-fit opened a third that only ever sat empty. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px clamp(22px, 3vw, 40px);
    margin: 0;
  }
  .detail .res {
    grid-column: 1 / -1;
  }
  .detail dt {
    color: var(--text-faint);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .detail dd {
    margin: 5px 0 0;
    color: var(--text-body);
    font-size: 0.89rem;
    line-height: 1.55;
  }
  .detail .res dd {
    color: var(--text-strong);
  }
  .src {
    color: var(--accent-text);
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    summary {
      grid-template-columns: minmax(0, 1fr) 18px;
      align-items: start;
    }
    .partner {
      grid-column: 1 / 2;
      text-align: left;
    }
    .detail {
      grid-template-columns: 1fr;
    }
  }
</style>