---
import { createRequire } from "module";
import { geoEquirectangular, geoPath } from "d3-geo";
import { feature } from "topojson-client";
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, note, points, projects, directoryHeading, directoryIntro, cta } =
  Astro.props as Extract<Block, { type: "countriesMap" }>;

const slug = (s: string) =>
  "project-" + s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
// A pin only becomes a link when the directory actually holds that country.
const documented = new Set(projects.map((pr) => pr.country));

const require = createRequire(import.meta.url);
const topo = require("world-atlas/countries-110m.json");
const countries = feature(topo, topo.objects.countries);

// The deployments span 215 deg of longitude but only 71 of latitude. Fitting the
// whole globe left 74% of the frame as empty ocean and Antarctica and pushed the
// Central America pins to 6.9px apart, closer than the dots are wide. Fitting the
// inhabited band instead makes the populated area 2.53x larger at the same width.
const LNG0 = -102;
const LNG1 = 113;
const LAT0 = -25;
const LAT1 = 46;
const W = 1000;
const H = Math.round((W * (LAT1 - LAT0)) / (LNG1 - LNG0));
// fitSize() cannot express this: it measures a polygon's edges as great circles,
// which bulge poleward and inflate the bounds back to the whole globe. The
// equirectangular projection is linear in lon/lat, so the fit is exact by hand.
const RAD = Math.PI / 180;
const k = W / ((LNG1 - LNG0) * RAD);
const projection = geoEquirectangular()
  .scale(k)
  .translate([-k * LNG0 * RAD, k * LAT1 * RAD]);
const worldPath = geoPath(projection)(countries) ?? "";
const pins = points
  .map((pt) => {
    const xy = projection([pt.lng, pt.lat]);
    return xy
      ? {
          country: pt.country,
          pos: pt.pos ?? "top",
          xPct: (xy[0] / W) * 100,
          yPct: (xy[1] / H) * 100,
        }
      : null;
  })
  .filter(Boolean) as {
  country: string;
  pos: string;
  xPct: number;
  yPct: number;
}[];
---

<section class="block countries">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <div class="map-wrap">
      <div class="map-frame">
        <svg
          viewBox={`0 0 ${W} ${H}`}
          class="map"
          role="img"
          aria-label="World map showing countries with documented GEOGLOWS deployments"
        >
          <path d={worldPath} class="world" />
        </svg>
        <div class="pins">
          {
            pins.map((p) =>
              documented.has(p.country) ? (
                <a
                  class="pin pin-link"
                  style={`left:${p.xPct}%;top:${p.yPct}%`}
                  href={`#${slug(p.country)}`}
                >
                  <span class="dot" />
                  <span class:list={["lbl", `lbl-${p.pos}`]}>{p.country}</span>
                </a>
              ) : (
                <span class="pin" style={`left:${p.xPct}%;top:${p.yPct}%`}>
                  <span class="dot" />
                  <span class:list={["lbl", `lbl-${p.pos}`]}>{p.country}</span>
                </span>
              ),
            )
          }
        </div>
      </div>
    </div>
    {note && <p class="note">{note}</p>}
    {
      projects.length > 0 && (
        <div class="directory" data-directory>
          {directoryHeading && <h3 class="dir-head">{directoryHeading}</h3>}
          {directoryIntro && <p class="dir-intro">{directoryIntro}</p>}
          <nav class="rail" aria-label="Countries with a documented project">
            {projects.map((pr) => (
              <a class="chip" href={`#${slug(pr.country)}`} data-chip={slug(pr.country)}>
                {pr.country}
              </a>
            ))}
          </nav>
          {projects.map((pr) => (
            <details class="project" id={slug(pr.country)} tabindex="-1">
              <summary>
                <span class="who">
                  <span class="name">{pr.country}</span>
                  <span class="status">{pr.status}</span>
                </span>
                <span class="partner">{pr.partner}</span>
                <span class="chev" aria-hidden="true" />
              </summary>
              <dl class="detail">
                <div>
                  <dt>Challenge</dt>
                  <dd>{pr.challenge}</dd>
                </div>
                <div>
                  <dt>GEOGLOWS application</dt>
                  <dd>{pr.application}</dd>
                </div>
                <div class="res">
                  <dt>Result</dt>
                  <dd>
                    {pr.result}
                    {pr.href && (
                      <>
                        {" "}
                        <a class="src" href={pr.href} target="_blank" rel="noopener">
                          Read more →
                        </a>
                      </>
                    )}
                  </dd>
                </div>
              </dl>
            </details>
          ))}
        </div>
      )
    }
    {
      cta && (
        <p class="all">
          <a href={cta.href}>{cta.label} →</a>
        </p>
      )
    }
  </div>
</section>

<script>
  // Progressive enhancement. Without JS every record stays in the page as the
  // collapsible list that already ships, which is what keeps this a definitive
  // record for print, in-page search and crawlers. JS upgrades wide viewports to
  // one-record-at-a-time; narrow ones keep the list.
  const WIDE = window.matchMedia("(min-width: 900px)");

  document.querySelectorAll("[data-directory]").forEach((dir) => {
    const records = [...dir.querySelectorAll("details.project")];
    if (!records.length) return;
    const chips = [...dir.querySelectorAll("[data-chip]")];
    const pins = [...document.querySelectorAll(".pin-link")];
    dir.dataset.mode = "panel";

    const select = (id, moveFocus) => {
      const target = records.find((r) => r.id === id) || records[0];
      records.forEach((r) => {
        const on = r === target;
        r.classList.toggle("is-active", on);
        if (WIDE.matches) r.open = on;
      });
      chips.forEach((c) => {
        const on = c.dataset.chip === target.id;
        c.classList.toggle("is-active", on);
        if (on) c.setAttribute("aria-current", "true");
        else c.removeAttribute("aria-current");
      });
      pins.forEach((pin) => {
        pin.classList.toggle("is-active", pin.getAttribute("href") === "#" + target.id);
      });
      // Focus follows selection so screen-reader and keyboard users land on the
      // record they just chose, but never on first paint.
      if (moveFocus && WIDE.matches) target.focus({ preventScroll: true });
      return target;
    };

    const fromHash = () => (location.hash ? location.hash.slice(1) : records[0].id);

    [...chips, ...pins].forEach((el) => {
      el.addEventListener("click", (e) => {
        const id = (el.dataset && el.dataset.chip) || el.getAttribute("href").slice(1);
        if (!records.some((r) => r.id === id)) return;
        if (WIDE.matches) {
          e.preventDefault();
          history.replaceState(null, "", "#" + id);
          select(id, true);
        }
      });
    });

    // In list mode a record opens on its own; keep the panel state in step.
    records.forEach((r) =>
      r.addEventListener("toggle", () => {
        if (!WIDE.matches && r.open) select(r.id, false);
      }),
    );

    WIDE.addEventListener("change", () => {
      if (WIDE.matches) select(fromHash(), false);
      else records.forEach((r) => (r.open = false));
    });

    window.addEventListener("hashchange", () => select(fromHash(), true));
    select(fromHash(), false);
  });
</script>

<style>

  .countries {
    --map-ocean: #e7ecf0;
    --map-land: #d3dbe1;
    --map-border: #ffffff;
    --map-pin: #7d93a5;
    --map-pin-live: var(--color-teal-green);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .countries {
      --map-ocean: #101b28;
      --map-land: #263749;
      --map-border: #101b28;
      --map-pin: #6c8296;
      --map-pin-live: #4fb3a4;
    }
  }
  :global(:root[data-theme="dark"]) .countries {
    --map-ocean: #101b28;
    --map-land: #263749;
    --map-border: #101b28;
    --map-pin: #6c8296;
    --map-pin-live: #4fb3a4;
  }
  :global(:root[data-theme="light"]) .countries {
    --map-ocean: #e7ecf0;
    --map-land: #d3dbe1;
    --map-border: #ffffff;
    --map-pin: #7d93a5;
    --map-pin-live: var(--color-teal-green);
  }

  .map-wrap {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--map-ocean);
    padding: clamp(10px, 2vw, 20px);
  }
  .map-frame {
    position: relative;
  }
  .map {
    width: 100%;
    height: auto;
    display: block;
  }
  .world {
    fill: var(--map-land);
    stroke: var(--map-border);
    stroke-width: 0.6;
    stroke-linejoin: round;
  }

  .pins {
    position: absolute;
    inset: 0;
  }

  /* 22 markers cannot all carry a permanent label without colliding, so the
     dot is always visible and the name appears on hover, tap or focus. */
  /* The tightest pair sits 11.5px apart, so a 28px hit box swallowed its
     neighbour: aiming at Guatemala selected El Salvador. 16px keeps each dot's
     centre its own: that pair is 6.8px apart horizontally and 8.8px vertically,
     so a 16px box still overlapped by a pixel and :hover lifted the wrong pin
     on top. The chip rail is the accessible full-size control. */
  .pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 12px;
    height: 12px;
    transform: translate(-50%, -50%);
    text-decoration: none;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--map-pin);
    border: 2px solid var(--surface-page);
    box-shadow: 0 1px 4px rgba(15, 23, 32, 0.45);
    transition: transform 0.16s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pin-link .dot {
    background: var(--map-pin-live);
  }
  .pin-link.is-active .dot {
    background: var(--map-pin-live);
    transform: scale(1.5);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--map-pin-live) 34%, transparent);
  }
  .pin:hover,
  .pin:focus {
    z-index: 5;
  }
  .pin:hover .dot,
  .pin:focus .dot {
    transform: scale(1.35);
  }
  .pin-link:focus-visible {
    outline: 2px solid var(--color-amber);
    outline-offset: 2px;
    border-radius: 50%;
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      transition: none;
    }
  }
  .lbl {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.14s ease;
    z-index: 6;
    padding: 2px 7px;
    border-radius: 6px;
    background: var(--surface-page);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    color: var(--text-strong);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  /* :focus as well as :focus-visible, so the name shows however focus arrives. */
  .pin:hover .lbl,
  .pin:focus .lbl,
  .pin:focus-visible .lbl {
    opacity: 1;
  }
  .lbl-top {
    bottom: calc(100% - 4px);
    left: 50%;
    transform: translateX(-50%);
  }
  .lbl-bottom {
    top: calc(100% - 4px);
    left: 50%;
    transform: translateX(-50%);
  }
  .lbl-left {
    right: calc(100% - 2px);
    top: 50%;
    transform: translateY(-50%);
  }
  .lbl-right {
    left: calc(100% - 2px);
    top: 50%;
    transform: translateY(-50%);
  }
  .note {
    margin-top: 14px;
    color: var(--text-faint);
    font-size: 0.9rem;
  }
  .all {
    margin-top: 20px;
  }
  .all a {
    color: var(--accent-text);
    font-weight: 800;
    text-decoration: none;
  }
  @media (max-width: 640px) {
    .lbl {
      font-size: 0.58rem;
      padding: 1px 5px;
    }
  }

  /* The definitive record: one row per documented project, country and status
     on the left, the six-field record on the right. */
  .directory {
    margin-top: clamp(44px, 5.5vw, 74px);
  }
  .dir-head {
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    letter-spacing: -0.01em;
  }
  .dir-intro {
    max-width: 66ch;
    margin-top: 10px;
    color: var(--text-body);
    font-size: 0.97rem;
    line-height: 1.6;
  }
  /* 15 full records ran to 3.7 screens. The record is unchanged; only the
     Challenge/Application/Result detail is folded away until asked for. */
  .project {
    border-top: 1px solid var(--border);
    scroll-margin-top: 90px;
  }
  .project:first-of-type {
    border-top-width: 2px;
    border-top-color: var(--accent-text);
  }
  .project:last-of-type {
    border-bottom: 1px solid var(--border);
  }
  summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 18px;
    align-items: center;
    gap: 10px clamp(16px, 2.4vw, 32px);
    min-height: 56px;
    padding: 9px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover .name,
  .project[open] .name {
    color: var(--accent-text);
  }
  summary:focus-visible {
    outline: 2px solid var(--color-amber);
    outline-offset: 3px;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .name {
    font-family: "Raleway", "Open Sans", system-ui, sans-serif;
    font-size: 1.12rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--text-strong);
  }
  /* The chevron rotates; nothing in the layout box animates. */
  .chev {
    justify-self: end;
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--text-faint);
    border-bottom: 2px solid var(--text-faint);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project[open] .chev {
    transform: rotate(-135deg) translate(-3px, -3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .chev {
      transition: none;
    }
  }
  .status {
    display: inline-block;
    padding: 3px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--accent-text);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .partner {
    color: var(--text-faint);
    font-size: 0.83rem;
    line-height: 1.45;
    text-align: right;
  }
  .detail {
    padding: 2px 0 clamp(22px, 2.6vw, 30px);
    display: grid;
    /* Two even columns: auto-fit opened a third that only ever sat empty. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px clamp(22px, 3vw, 40px);
    margin: 0;
  }
  .detail .res {
    grid-column: 1 / -1;
  }
  .detail dt {
    color: var(--text-faint);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .detail dd {
    margin: 5px 0 0;
    color: var(--text-body);
    font-size: 0.89rem;
    line-height: 1.55;
  }
  .detail .res dd {
    color: var(--text-strong);
  }
  .src {
    color: var(--accent-text);
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    summary {
      grid-template-columns: minmax(0, 1fr) 18px;
      align-items: start;
    }
    .partner {
      grid-column: 1 / 2;
      text-align: left;
    }
    .detail {
      grid-template-columns: 1fr;
    }
  }

  /* The chip rail is navigation, not decoration: in panel mode the map would
     otherwise be the only way to reach a country. */
  .rail {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 22px 0 6px;
  }
  .chip {
    padding: 6px 13px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-body);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.16s ease, border-color 0.16s ease;
  }
  .chip:hover {
    color: var(--accent-text);
    border-color: var(--accent-text);
  }
  .chip.is-active {
    color: var(--surface-page);
    background: var(--accent-text);
    border-color: var(--accent-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .chip {
      transition: none;
    }
  }

  /* Panel mode: wide viewports show one record, narrow ones keep the list.
     Without JS neither rule applies and all 15 stay browsable. */
  @media (min-width: 900px) {
    [data-directory][data-mode="panel"] .project {
      display: none;
      border-top: 0;
    }
    [data-directory][data-mode="panel"] .project.is-active {
      display: block;
    }
    [data-directory][data-mode="panel"] .project:last-of-type {
      border-bottom: 0;
    }
    [data-directory][data-mode="panel"] summary {
      cursor: default;
      border-top: 2px solid var(--accent-text);
    }
    [data-directory][data-mode="panel"] .chev {
      display: none;
    }
    [data-directory][data-mode="panel"] .project[open] .name {
      color: var(--text-strong);
    }
    [data-directory][data-mode="panel"] .name {
      font-size: 1.32rem;
    }
    [data-directory][data-mode="panel"] .project.is-active {
      animation: record-in 0.26s cubic-bezier(0.22, 1, 0.36, 1);
    }
    [data-directory][data-mode="panel"] .project:focus-visible {
      outline: 2px solid var(--color-amber);
      outline-offset: 6px;
    }
  }
  @media (min-width: 900px) and (prefers-reduced-motion: reduce) {
    [data-directory][data-mode="panel"] .project.is-active {
      animation: none;
    }
  }
  /* Opacity only; nothing in the layout box animates. */
  @keyframes record-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  /* The rail replaces the list as the index, so it is panel-mode only. */
  @media (max-width: 899px) {
    .rail {
      display: none;
    }
    /* Hover labels cannot fire on touch, and edge pins pushed them past the
       viewport, which gave the page a horizontal scroll. Tapping a pin opens
       the record, which names the country anyway. */
    .lbl {
      display: none;
    }
  }
</style>