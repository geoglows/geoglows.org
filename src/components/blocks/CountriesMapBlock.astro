---
import { createRequire } from "module";
import { geoEquirectangular, geoPath } from "d3-geo";
import { feature } from "topojson-client";
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";

const { eyebrow, heading, intro, note, points, projects, directoryHeading, directoryIntro, cta } =
  Astro.props as Extract<Block, { type: "countriesMap" }>;

const slug = (s: string) =>
  "project-" + s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

const require = createRequire(import.meta.url);
const topo = require("world-atlas/countries-110m.json");
const countries = feature(topo, topo.objects.countries);

// The deployments span 215 deg of longitude but only 71 of latitude. Fitting the
// whole globe left 74% of the frame as empty ocean and Antarctica and pushed the
// Central America pins to 6.9px apart, closer than the dots are wide. Fitting the
// inhabited band instead makes the populated area 2.53x larger at the same width.
const LNG0 = -102;
const LNG1 = 113;
const LAT0 = -25;
const LAT1 = 46;
const W = 1000;
const H = Math.round((W * (LAT1 - LAT0)) / (LNG1 - LNG0));
// fitSize() cannot express this: it measures a polygon's edges as great circles,
// which bulge poleward and inflate the bounds back to the whole globe. The
// equirectangular projection is linear in lon/lat, so the fit is exact by hand.
const RAD = Math.PI / 180;
const k = W / ((LNG1 - LNG0) * RAD);
const projection = geoEquirectangular()
  .scale(k)
  .translate([-k * LNG0 * RAD, k * LAT1 * RAD]);
const path = geoPath(projection);

// The map is now a choropleth: the countries carrying a project are the markers.
// world-atlas abbreviates a few names, so the aliases bridge content to shapes.
const ALIAS: Record<string, string> = { "Dominican Republic": "Dominican Rep." };
const shapeName = (c: string) => ALIAS[c] ?? c;
const byName = new Map(
  (countries as any).features.map((f: any) => [f.properties?.name, f]),
);
const wanted = new Set(projects.map((pr) => shapeName(pr.country)));

const basePath =
  path({
    type: "FeatureCollection",
    features: (countries as any).features.filter(
      (f: any) => !wanted.has(f.properties?.name),
    ),
  } as any) ?? "";

const shapes = projects
  .map((pr) => {
    const f = byName.get(shapeName(pr.country));
    const d = f ? path(f) : null;
    return d ? { country: pr.country, id: slug(pr.country), d } : null;
  })
  .filter(Boolean) as { country: string; id: string; d: string }[];

// Anything the atlas cannot draw would silently vanish from the map, so it keeps
// a marker instead of disappearing.
const drawn = new Set(shapes.map((s) => s.country));
const fallbackPins = projects
  .filter((pr) => !drawn.has(pr.country))
  .map((pr) => {
    const pt = points.find((x) => x.country === pr.country);
    const xy = pt ? projection([pt.lng, pt.lat]) : null;
    return xy
      ? { country: pr.country, id: slug(pr.country), xPct: (xy[0] / W) * 100, yPct: (xy[1] / H) * 100 }
      : null;
  })
  .filter(Boolean) as { country: string; id: string; xPct: number; yPct: number }[];
---

<section class="block countries">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <div class="map-wrap">
      <div class="map-frame">
        <svg
          viewBox={`0 0 ${W} ${H}`}
          class="map"
          role="img"
          aria-label="Map of the countries with a documented GEOGLOWS project"
        >
          <path d={basePath} class="world" />
          {
            shapes.map((s) => (
              <a href={`#${s.id}`} class="land" data-land={s.id} aria-label={s.country}>
                <title>{s.country}</title>
                <path d={s.d} />
              </a>
            ))
          }
        </svg>
        {
          fallbackPins.length > 0 && (
            <div class="pins">
              {fallbackPins.map((f) => (
                <a
                  class="pin"
                  style={`left:${f.xPct}%;top:${f.yPct}%`}
                  href={`#${f.id}`}
                  data-land={f.id}
                  aria-label={f.country}
                >
                  <span class="dot" />
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
    {note && <p class="note">{note}</p>}
    {
      projects.length > 0 && (
        <div class="directory" data-directory>
          {directoryHeading && <h3 class="dir-head">{directoryHeading}</h3>}
          {directoryIntro && <p class="dir-intro">{directoryIntro}</p>}
          <div class="grid">
          {projects.map((pr) => (
            <article class="project" id={slug(pr.country)} data-card={slug(pr.country)}>
              <header>
                {/* The heading is the control, so selection works without JS
                    and lands in the tab order once per card. */}
                <h4>
                  <a class="pick" href={`#${slug(pr.country)}`}>{pr.country}</a>
                </h4>
                <span class="status">{pr.status}</span>
              </header>
              {
                pr.partners.length > 0 && (
                  <p class="partners">
                    {pr.partners.map((o, i) => (
                      <>
                        {i > 0 && <span class="sep"> · </span>}
                        {o.url ? (
                          <a href={o.url} target="_blank" rel="noopener">
                            {o.name}
                          </a>
                        ) : (
                          <span>{o.name}</span>
                        )}
                      </>
                    ))}
                  </p>
                )
              }
              <dl class="detail">
                <div>
                  <dt>Challenge</dt>
                  <dd>{pr.challenge}</dd>
                </div>
                <div>
                  <dt>GEOGLOWS application</dt>
                  <dd>{pr.application}</dd>
                </div>
                <div>
                  <dt>Result</dt>
                  <dd>
                    {pr.result}
                    {pr.href && (
                      <>
                        {" "}
                        <a class="src" href={pr.href} target="_blank" rel="noopener">
                          Read more →
                        </a>
                      </>
                    )}
                  </dd>
                </div>
              </dl>
            </article>
          ))}
          </div>
        </div>
      )
    }
    {
      cta && (
        <p class="all">
          <a href={cta.href}>{cta.label} →</a>
        </p>
      )
    }
  </div>
</section>

<script>
  // Nothing here is required to read the directory: every field is already on
  // every card. This only links the map to the cards and marks the selection.
  document.querySelectorAll("[data-directory]").forEach((dir) => {
    const cards = [...dir.querySelectorAll("[data-card]")];
    if (!cards.length) return;
    const lands = [...document.querySelectorAll("[data-land]")];

    const select = (id, scroll) => {
      const card = cards.find((c) => c.id === id);
      if (!card) return;
      cards.forEach((c) => c.classList.toggle("is-active", c === card));
      lands.forEach((l) => l.classList.toggle("is-active", l.dataset.land === id));
      // Restart the glow even when the same country is picked twice.
      card.classList.remove("is-active");
      void card.offsetWidth;
      card.classList.add("is-active");
      if (scroll) card.scrollIntoView({ block: "center", behavior: "smooth" });
    };

    lands.forEach((land) =>
      land.addEventListener("click", (e) => {
        e.preventDefault();
        pick(land.dataset.land, true);
      }),
    );

    // Clicking anywhere on a card selects it too, but never steals a click that
    // was aimed at a partner site or a source link.
    cards.forEach((card) =>
      card.addEventListener("click", (e) => {
        const link = e.target.closest("a");
        if (link && !link.classList.contains("pick")) return;
        e.preventDefault();
        // No scroll: the card you clicked is already in front of you.
        pick(card.id, false);
      }),
    );

    const pick = (id, scroll) => {
      history.replaceState(null, "", "#" + id);
      select(id, scroll);
    };

    window.addEventListener("hashchange", () =>
      select(location.hash.slice(1), true),
    );
    if (location.hash) select(location.hash.slice(1), false);
  });
</script>

<style>
  .countries {
    --map-ocean: #e7ecf0;
    --map-land: #d3dbe1;
    --map-border: #ffffff;
    --map-project: #7fc4ba;
    --map-project-on: var(--color-teal-green);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .countries {
      --map-ocean: #101b28;
      --map-land: #263749;
      --map-border: #101b28;
      --map-project: #2f7d74;
      --map-project-on: #5fd0be;
    }
  }
  :global(:root[data-theme="dark"]) .countries {
    --map-ocean: #101b28;
    --map-land: #263749;
    --map-border: #101b28;
    --map-project: #2f7d74;
    --map-project-on: #5fd0be;
  }
  :global(:root[data-theme="light"]) .countries {
    --map-ocean: #e7ecf0;
    --map-land: #d3dbe1;
    --map-border: #ffffff;
    --map-project: #7fc4ba;
    --map-project-on: var(--color-teal-green);
  }

  .map-wrap {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--map-ocean);
    padding: clamp(10px, 2vw, 20px);
  }
  .map-frame {
    position: relative;
  }
  .map {
    display: block;
    width: 100%;
    height: auto;
  }
  .world {
    fill: var(--map-land);
    stroke: var(--map-border);
    stroke-width: 0.4;
  }
  /* The countries carrying a project are the markers now. */
  .land path {
    fill: var(--map-project);
    stroke: var(--map-border);
    stroke-width: 0.4;
    transition: fill 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .land:hover path,
  .land:focus-visible path {
    fill: var(--map-project-on);
  }
  .land:focus-visible {
    outline: 2px solid var(--color-amber);
    outline-offset: 2px;
  }
  .land.is-active path {
    fill: var(--map-project-on);
    stroke: var(--map-project-on);
    stroke-width: 1.6;
    paint-order: stroke;
  }
  @media (prefers-reduced-motion: reduce) {
    .land path {
      transition: none;
    }
  }
  /* Only for a country the atlas cannot draw, so it never silently vanishes. */
  .pins {
    position: absolute;
    inset: 0;
  }
  .pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 14px;
    height: 14px;
    transform: translate(-50%, -50%);
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--map-project-on);
    border: 2px solid var(--surface-page);
  }

  .note {
    margin-top: 14px;
    color: var(--text-body);
    font-size: 0.88rem;
    line-height: 1.55;
  }
  .all {
    margin-top: 22px;
  }
  .all a {
    color: var(--accent-text);
    font-weight: 800;
    text-decoration: none;
  }

  .directory {
    margin-top: clamp(44px, 5.5vw, 74px);
  }
  .dir-head {
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    letter-spacing: -0.01em;
  }
  .dir-intro {
    max-width: 66ch;
    margin-top: 10px;
    color: var(--text-body);
    font-size: 0.97rem;
    line-height: 1.6;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 16px;
    margin-top: 22px;
  }
  /* Every field is on the face: nothing opens, so nothing is hidden. */
  .project {
    padding: 20px 20px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-page);
    scroll-margin-top: 100px;
    transition: border-color 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project header {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .project h4 {
    font-family: "Raleway", "Open Sans", system-ui, sans-serif;
    font-size: 1.16rem;
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--text-strong);
  }
  .status {
    display: inline-block;
    padding: 3px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--accent-text);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .partners {
    margin-top: 9px;
    color: var(--text-faint);
    font-size: 0.81rem;
    line-height: 1.5;
  }
  .partners a {
    color: var(--text-faint);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: color 0.16s ease, text-decoration-color 0.16s ease;
  }
  .partners a:hover,
  .partners a:focus-visible {
    color: var(--accent-text);
    text-decoration-color: currentColor;
  }
  .pick {
    color: inherit;
    text-decoration: none;
  }
  .pick:focus-visible {
    outline: 2px solid var(--color-amber);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .project:hover .pick {
    color: var(--accent-text);
  }
  /* The whole card is a convenience target; the heading link is the real one. */
  .project {
    cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) {
    .partners a {
      transition: none;
    }
  }
  .detail {
    margin: 15px 0 0;
    display: grid;
    gap: 13px;
  }
  .detail dt {
    color: var(--text-faint);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .detail dd {
    margin: 4px 0 0;
    color: var(--text-body);
    font-size: 0.87rem;
    line-height: 1.5;
  }
  .src {
    color: var(--accent-text);
    font-weight: 700;
    white-space: nowrap;
  }

  /* Selection: the border and ring carry it, and a brief glow pulls the eye to
     the card that just scrolled into view. Colour and shadow only; the card's
     box never changes size, so no layout is animated. */
  .project.is-active {
    border-color: var(--map-project-on);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--map-project-on) 26%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .project.is-active {
      animation: card-land 1.15s cubic-bezier(0.22, 1, 0.36, 1);
    }
  }
  @keyframes card-land {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--map-project-on) 55%, transparent);
    }
    38% {
      box-shadow: 0 0 0 11px color-mix(in srgb, var(--map-project-on) 34%, transparent);
    }
    100% {
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--map-project-on) 26%, transparent);
    }
  }
</style>