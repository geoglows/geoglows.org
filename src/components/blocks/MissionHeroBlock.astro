---
import { getCollection } from "astro:content";
import type { Block } from "../../schemas/blocks";
import GeoGlyph from "../site/GeoGlyph.astro";
import { bgImage } from "../../lib/css";
import { formatPostDate } from "../../lib/date";

const { eyebrow, heading, lede, image, spotlight, spotlightLink, socialHeading, socialCount } =
  Astro.props as Extract<Block, { type: "missionHero" }>;

const posts = (await getCollection("social"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, socialCount);
---

<section class="block hero-mission">
  <div class="shell grid">
    <div class="lead">
      <p class="eyebrow"><GeoGlyph />{eyebrow}</p>
      <h1>{heading}</h1>
      {lede && <p class="lede">{lede}</p>}
      {
        spotlight.length > 0 && (
          <div class="spotlight">
            {spotlight.map((item) => (
              <div class="spot">
                <span class="tag">{item.tag}</span>
                <p>{item.text}</p>
              </div>
            ))}
            {spotlightLink && (
              <a class="more" href={spotlightLink.href}>
                {spotlightLink.label} →
              </a>
            )}
          </div>
        )
      }
    </div>

    <div class="rail">
      {image && <img class="hero-img" src={image} alt="" loading="eager" fetchpriority="high" />}
      <aside class="panel" aria-label={socialHeading}>
        <div class="p-head">
          <span class="li-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
            </svg>
          </span>
          <span class="p-title">
            <span class="p-name">{socialHeading}</span>
            <span class="p-sub">GEOGLOWS on LinkedIn</span>
          </span>
        </div>
        <div class="posts">
          {posts.map((post) => (
            <a class="post" href={post.data.url} target="_blank" rel="noopener">
              {post.data.image && <span class="thumb" style={bgImage(post.data.image)} />}
              <span class="post-body">
                <span class="date">{formatPostDate(post.data.date)}</span>
                <span class="excerpt">{post.data.excerpt}</span>
              </span>
            </a>
          ))}
        </div>
        <div class="follow">
          <a href="https://www.linkedin.com/company/geoglows" target="_blank" rel="noopener">Follow on LinkedIn →</a>
          <a href="/community#news">All updates →</a>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .hero-mission {
    padding-top: clamp(48px, 6vw, 88px);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 5vw, 60px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--accent-text);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  h1 {
    font-size: clamp(2.1rem, 4.4vw, 3.2rem);
    letter-spacing: -0.02em;
    line-height: 1.08;
    max-width: 15ch;
  }
  .lede {
    margin-top: 20px;
    max-width: 52ch;
    font-size: 1.12rem;
    color: var(--text-body);
  }
  .spotlight {
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .spot .tag {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--surface-teal-wash);
    color: var(--accent-text);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .spot p {
    margin-top: 8px;
    max-width: 54ch;
    color: var(--text-body);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .more {
    color: var(--accent-text);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .hero-img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }
  .panel {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-page);
    box-shadow: var(--shadow-sm);
    padding: 22px 24px;
  }
  .p-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 14px;
    margin-bottom: 2px;
    border-bottom: 1px solid var(--border);
  }
  .li-badge {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: #0a66c2;
    color: #fff;
    flex-shrink: 0;
  }
  .p-title {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .p-name {
    font-weight: 800;
    font-size: 0.98rem;
    color: var(--text-strong);
  }
  .p-sub {
    color: var(--text-faint);
    font-size: 0.74rem;
    font-weight: 600;
  }
  .post {
    display: flex;
    gap: 12px;
    padding: 13px 8px;
    margin: 0 -8px;
    border-radius: 10px;
    border-top: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: background 0.16s ease;
  }
  .post:first-child {
    border-top: none;
  }
  .post:hover {
    background: var(--surface-wash);
  }
  .thumb {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 8px;
    background-size: cover;
    background-position: center;
  }
  .post-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .post .date {
    color: var(--text-faint);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .excerpt {
    font-size: 0.86rem;
    line-height: 1.42;
    color: var(--text-body);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post:hover .excerpt {
    color: var(--text-strong);
  }
  .follow {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  .follow a {
    color: var(--accent-text);
    font-weight: 700;
    font-size: 0.82rem;
    text-decoration: none;
  }
</style>
