---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";
import CtaButton from "../ui/CtaButton.astro";

const { eyebrow, heading, intro, stats, note, cta } = Astro.props as Extract<
  Block,
  { type: "investment" }
>;
---

<section class="block">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <div class="stats">
      {
        stats.map((s) => (
          <div class="cell">
            <div class="num">{s.value}</div>
            <div class="lbl">{s.label}</div>
          </div>
        ))
      }
    </div>
    {note && <p class="note">{note}</p>}
    {cta && <div class="cta"><CtaButton href={cta.href} label={cta.label} style={cta.style} /></div>}
  </div>
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (max-width: 720px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
  }
  .cell {
    background: var(--surface-page);
    padding: 24px;
  }
  .num {
    color: var(--accent-text);
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .lbl {
    margin-top: 6px;
    color: var(--text-body);
    font-size: 0.86rem;
    line-height: 1.4;
  }
  .note {
    margin-top: 24px;
    max-width: 72ch;
    color: var(--text-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .cta {
    margin-top: 26px;
  }
</style>
