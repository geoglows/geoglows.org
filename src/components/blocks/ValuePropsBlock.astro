---
import type { Block } from "../../schemas/blocks";
import SectionHeader from "../ui/SectionHeader.astro";
import CtaButton from "../ui/CtaButton.astro";

const { eyebrow, heading, intro, items, compact, cta } = Astro.props as Extract<
  Block,
  { type: "valueProps" }
>;
---

<section class="block muted">
  <div class="shell">
    <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro} align="left" />
    <div class:list={["grid", { strip: compact }]}>
      {
        items.map((item) => (
          <div class="value">
            {!compact && <span class="rule" />}
            <h3>{item.title}</h3>
            {item.text && <p>{item.text}</p>}
          </div>
        ))
      }
    </div>
    {cta && <div class="cta-row"><CtaButton href={cta.href} label={cta.label} style="green" /></div>}
  </div>
</section>

<style>
  .muted {
    background: var(--surface-muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 4vw, 56px);
  }
  .rule {
    display: block;
    width: 48px;
    height: 4px;
    margin-bottom: 20px;
    background: var(--color-teal-green);
    border-radius: 2px;
  }
  h3 {
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    line-height: 1.15;
  }
  p {
    margin-top: 10px;
    max-width: 40ch;
    color: var(--text-body);
    font-size: 0.98rem;
  }
  .cta-row {
    margin-top: 44px;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* Compact: these facts are explained stage by stage above, so here they only
     need naming, with the detail that is genuinely new to V2. */
  .grid.strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px clamp(24px, 3vw, 44px);
    margin-top: 22px;
  }
  .grid.strip .value {
    padding: 0;
    border: 0;
  }
  .grid.strip h3 {
    margin: 0;
    color: var(--text-strong);
    font-size: 0.97rem;
  }
  .grid.strip p {
    margin-top: 3px;
    /* --text-faint measured 3.83:1 on the muted surface, under AA. */
    color: var(--text-body);
    font-size: 0.83rem;
    line-height: 1.45;
  }
</style>