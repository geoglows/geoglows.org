---
import net from "../../data/pipeline-network.json";

// Three panels over one patch of ground, so the transformation is shown rather
// than asserted: a coarse meteorological grid becomes a vector river network.
// Geometry is real TDX-Hydro, baked at build time.
const W = 300;
const H = 232;
const busiest = Math.max(...net.cells.map((c) => c.n));
const maxOrder = Math.max(...net.reaches.map((r) => r.order));

const X = (v: number) => (v * W).toFixed(1);
const Y = (v: number) => (v * H).toFixed(1);
const line = (pts: number[][]) =>
  pts.map(([x, y], i) => `${i ? "L" : "M"}${X(x)} ${Y(y)}`).join("");

// Runoff shading stands in for "more water off this cell", using reach density
// as the proxy the figure already earns. Labelled as such in the caption.
const shade = (n: number) => (n === 0 ? 0 : 0.14 + 0.62 * (n / busiest));
const width = (order: number) => 0.5 + 1.9 * (order / maxOrder);

// A single reach among 256 reads as nothing at this size, so the one the chart
// plots gets a marker as well as a heavier stroke.
const plotted = net.reaches.find((r) => r.main);
const marker = plotted ? plotted.d[Math.floor(plotted.d.length / 2)] : null;

const panels = [
  { key: "grid", label: "Meteorological grid", note: `${net.cell_degrees}° cells` },
  { key: "runoff", label: "Runoff per cell", note: "same cells, shaded" },
  { key: "network", label: "TDX-Hydro reaches", note: `${net.reach_count} in view, one plotted below` },
];
---

<figure class="schema">
  <div class="panels">
    {
      panels.map((p) => (
        <div class="panel">
          <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${p.label}: ${p.note}`}>
            {/* The network panel keeps the grid, faintly, so a reader can count
                reaches inside one cell rather than taking the caption's word. */}
            {net.cells.map((c) => (
                <rect
                  class:list={["cell", { filled: p.key === "runoff", ghost: p.key === "network" }]}
                  x={X(c.x)}
                  y={Y(c.y)}
                  width={X(c.w)}
                  height={Y(c.h)}
                  style={p.key === "runoff" ? `opacity:${shade(c.n).toFixed(3)}` : undefined}
                />
              ))}
            {p.key === "network" &&
              net.reaches.map((r) => (
                <path
                  class:list={["reach", { main: r.main }]}
                  d={line(r.d)}
                  style={`stroke-width:${width(r.order).toFixed(2)}`}
                />
              ))}
            {p.key === "network" && marker && (
              <>
                <circle class="pin-halo" cx={X(marker[0])} cy={Y(marker[1])} r="7" />
                <circle class="pin" cx={X(marker[0])} cy={Y(marker[1])} r="3.4" />
              </>
            )}
          </svg>
          <p class="cap">
            <span class="lab">{p.label}</span>
            <span class="note">{p.note}</span>
          </p>
        </div>
      ))
    }
  </div>
  <figcaption>
    The first three stages over one patch of ground. One {net.cell_degrees}° cell of the
    meteorological grid holds up to {busiest} modelled river reaches. Real TDX-Hydro geometry for the {net.label}, the basin the forecast
    below is drawn from, retrieved {net.retrieved}. The middle panel shades each cell by the
    reaches it contains.
  </figcaption>
</figure>

<style>
  .schema {
    margin: 0 0 clamp(32px, 4vw, 46px);
  }
  .panels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(14px, 2vw, 26px);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    background: var(--surface-page);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .cell {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
  }
  .cell.ghost {
    stroke: var(--border);
    opacity: 0.55;
  }
  .cell.filled {
    fill: var(--accent);
    stroke: var(--surface-page);
    stroke-width: 0.5;
  }
  .reach {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.75;
  }
  /* The reach the chart below plots, so figure and chart are the same river. */
  .reach.main {
    stroke: var(--accent-text);
    stroke-width: 3 !important;
    opacity: 1;
  }
  .pin-halo {
    fill: none;
    stroke: var(--accent-text);
    stroke-width: 1.4;
    opacity: 0.55;
  }
  .pin {
    fill: var(--accent-text);
    stroke: var(--surface-page);
    stroke-width: 1.4;
  }
  .cap {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 3px 8px;
    margin-top: 10px;
  }
  .lab {
    color: var(--text-strong);
    font-size: 0.82rem;
    font-weight: 700;
  }
  .note {
    flex-basis: 100%;
    color: var(--text-faint);
    font-size: 0.74rem;
  }
  figcaption {
    max-width: 78ch;
    margin-top: 16px;
    color: var(--text-faint);
    font-size: 0.78rem;
    line-height: 1.55;
  }
  @media (max-width: 720px) {
    .panels {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
