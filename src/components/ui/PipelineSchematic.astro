---
import net from "../../data/pipeline-network.json";

// One frame, real geometry only. The earlier three-panel version spent two
// thirds of its space drawing the same empty grid twice, and shaded one of them
// by reach density under a "Runoff per cell" label, which is a chart of one
// thing named after another.
const W = 1100;
const H = 460;
const X = (v: number) => (v * W).toFixed(1);
const Y = (v: number) => (v * H).toFixed(1);
const line = (pts: number[][]) =>
  pts.map(([x, y], i) => `${i ? "L" : "M"}${X(x)} ${Y(y)}`).join("");

const maxOrder = Math.max(...net.reaches.map((r) => r.order));
const width = (order: number) => 0.5 + 2.2 * (order / maxOrder);

// The claim the figure exists to make, drawn on the one cell that makes it.
const busiest = net.cells.reduce((a, c) => (c.n > a.n ? c : a));
const plotted = net.reaches.find((r) => r.main);
const marker = plotted ? plotted.d[Math.floor(plotted.d.length / 2)] : null;
---

<figure class="schema">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={`The ${net.label} river network. ${net.reach_count} TDX-Hydro reaches across ${net.cells.length} cells of the ${net.cell_degrees} degree meteorological grid; the busiest single cell contains ${busiest.n} reaches.`}
  >
    {
      net.cells.map((c) => (
        <rect class="cell" x={X(c.x)} y={Y(c.y)} width={X(c.w)} height={Y(c.h)} />
      ))
    }
    {
      net.reaches.map((r) => (
        <path
          class:list={["reach", { main: r.main }]}
          d={line(r.d)}
          style={`stroke-width:${width(r.order).toFixed(2)}`}
        />
      ))
    }
    <rect
      class="call"
      x={X(busiest.x)}
      y={Y(busiest.y)}
      width={X(busiest.w)}
      height={Y(busiest.h)}
    />
    {
      marker && (
        <>
          <circle class="pin-halo" cx={X(marker[0])} cy={Y(marker[1])} r="11" />
          <circle class="pin" cx={X(marker[0])} cy={Y(marker[1])} r="4.5" />
        </>
      )
    }
  </svg>

  <figcaption>
    <span class="lede">
      {/* Not "527 across 72 cells": 21 reaches have midpoints outside the grid,
          so that phrasing implies a sum that does not add up. */}
      <b>{net.reach_count} river reaches</b> in this frame. The {net.cell_degrees}°
      meteorological grid divides it into {net.cells.length} cells, and the outlined
      one alone holds <b>{busiest.n}</b>.
    </span>
    <span class="keys">
      <span class="k"><i class="k-cell"></i>Grid cell</span>
      <span class="k"><i class="k-call"></i>Busiest cell</span>
      <span class="k"><i class="k-pin"></i>The reach plotted below</span>
    </span>
    <span class="src">
      Real TDX-Hydro geometry, {net.label}, retrieved {net.retrieved}. This is the step
      the chain turns on: a coarse grid of weather becomes a vector network of rivers.
    </span>
  </figcaption>
</figure>

<style>
  .schema {
    margin: 0 0 clamp(34px, 4.5vw, 50px);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    background: var(--surface-page);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .cell {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
  }
  .reach {
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.8;
  }
  .reach.main {
    stroke: var(--accent-text);
    stroke-width: 3.4 !important;
    opacity: 1;
  }
  .call {
    fill: none;
    stroke: var(--accent-text);
    stroke-width: 2.4;
  }
  .pin-halo {
    fill: none;
    stroke: var(--accent-text);
    stroke-width: 1.6;
    opacity: 0.5;
  }
  .pin {
    fill: var(--accent-text);
    stroke: var(--surface-page);
    stroke-width: 2;
  }
  figcaption {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }
  .lede {
    max-width: 62ch;
    color: var(--text-body);
    font-size: 0.97rem;
    line-height: 1.55;
  }
  .lede b {
    color: var(--text-strong);
    font-weight: 700;
  }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .k {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-faint);
    font-size: 0.78rem;
  }
  .k i {
    width: 13px;
    height: 10px;
  }
  .k-cell {
    border: 1px solid var(--border);
  }
  .k-call {
    border: 2px solid var(--accent-text);
  }
  .k-pin {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-text);
  }
  .src {
    max-width: 78ch;
    color: var(--text-faint);
    font-size: 0.78rem;
    line-height: 1.55;
  }
</style>
