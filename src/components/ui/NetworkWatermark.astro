---
import net from "../../data/pipeline-network.json";

// Real TDX-Hydro geometry and the real 0.1 degree meteorological grid it is
// sampled onto, reused as section texture. Nothing on this layer is meant to be
// read, so the cell counts, the callout and the pin are all dropped: a
// watermark that carries a claim is a figure nobody can see.
const W = 1100;
const H = 460;
const line = (pts: number[][]) =>
  // Integer precision: one unit is 0.09% of the frame, and nothing here is
  // read, so one decimal place cost 34% more path data for no visible change.
  pts.map(([x, y], i) => `${i ? "L" : "M"}${Math.round(x * W)} ${Math.round(y * H)}`).join("");

// Every order, down to the headwaters. Drawing the trunks alone left the
// network as a handful of parallel lines ending in mid-air; the capillaries are
// what make it read as one drainage basin rather than fragments.
const orders = net.reaches.map((r) => r.order);
const minOrder = Math.min(...orders);
// Geometric, not linear. A linear ramp put a headwater and a trunk within 2:1
// of each other, which is the one relationship a river drawing has to get
// right. The floor keeps the smallest streams above a hairline.
const width = (order: number) => 0.9 + 0.55 * Math.pow(1.75, order - minOrder);

// The grid's pitch and alignment are read back off the baked cells rather than
// assumed, so the lattice stays true if the basin or the cell size changes.
const uniq = (v: number[]) => [...new Set(v.map(Math.round))].sort((a, b) => a - b);
const colEdges = uniq(net.cells.flatMap((c) => [c.x * W, (c.x + c.w) * W]));
const rowEdges = uniq(net.cells.flatMap((c) => [c.y * H, (c.y + c.h) * H]));
// The first and last gaps are cells the bounding box cut through, so the true
// pitch is the widest one. Anchoring on an interior edge keeps the lattice in
// register with the cells the reaches were counted into.
const step = (e: number[]) => Math.max(...e.slice(1).map((v, i) => v - e[i]));
const [pitchX, pitchY] = [step(colEdges), step(rowEdges)];
const [anchorX, anchorY] = [colEdges[1], rowEdges[1]];

// One frame for both layers, so every cell boundary lands on the streams
// exactly where it does in the data. The frame is far taller than the basin
// because the column it sits in is: a lattice tiles happily at any aspect, so
// the grid runs the whole height at its true pitch while the streams stay at
// their true scale and read as a band across it. Stretching either one to fill
// the column would have put the cell boundaries in the wrong place.
const VIEW = { w: 1114, h: 2177 };
const VIEW_X = Math.round(W / 2 - VIEW.w / 2);
const VIEW_Y = Math.round(H / 2 - VIEW.h / 2);

// Half-degree lines carry the graticule; the 0.1 degree cells sit inside them.
// A flat lattice of identical lines read as graph paper, which is the one thing
// a meteorological grid is not.
const lonAt = (x: number) => net.box.w + (x / W) * (net.box.e - net.box.w);
const latAt = (y: number) => net.box.n - (y / H) * (net.box.n - net.box.s);
const isRound = (deg: number) => Math.abs(deg / 0.5 - Math.round(deg / 0.5)) < 0.02;

const ticks = (anchor: number, pitch: number, from: number, to: number) => {
  const first = anchor - Math.ceil((anchor - from) / pitch) * pitch;
  const out: number[] = [];
  for (let v = first; v <= to; v += pitch) out.push(v);
  return out;
};
const columns = ticks(anchorX, pitchX, VIEW_X, VIEW_X + VIEW.w).map((x) => ({
  v: x,
  major: isRound(lonAt(x)),
}));
const rows = ticks(anchorY, pitchY, VIEW_Y, VIEW_Y + VIEW.h).map((y) => ({
  v: y,
  major: isRound(latAt(y)),
}));
---

<svg
  class="mark"
  viewBox={`${VIEW_X} ${VIEW_Y} ${VIEW.w} ${VIEW.h}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g class="mesh">
    {
      columns.map((c) => (
        <line
          class:list={{ major: c.major }}
          x1={c.v}
          y1={VIEW_Y}
          x2={c.v}
          y2={VIEW_Y + VIEW.h}
        />
      ))
    }
    {
      rows.map((r) => (
        <line
          class:list={{ major: r.major }}
          x1={VIEW_X}
          y1={r.v}
          x2={VIEW_X + VIEW.w}
          y2={r.v}
        />
      ))
    }
  </g>
  {
    net.reaches.map((r) => (
      <path d={line(r.d)} style={`stroke-width:${width(r.order).toFixed(2)}`} />
    ))
  }
</svg>

<style>
  .mark {
    display: block;
    width: 100%;
    height: 100%;
  }
  .mark path {
    fill: none;
    stroke: var(--accent-text);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Lighter than the streams it sits under: the grid is the surface the water
     arrives on, not the subject. Non-scaling strokes keep the lines even. */
  .mesh line {
    stroke: var(--accent-text);
    stroke-width: 0.9;
    vector-effect: non-scaling-stroke;
    stroke-opacity: 0.45;
  }
  .mesh line.major {
    stroke-width: 1.4;
    stroke-opacity: 0.8;
  }
</style>
