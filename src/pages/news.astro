---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import NewsCard from "../components/cards/NewsCard.astro";
import SocialFeed from "../components/blocks/SocialFeed.astro";

const entries = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const posts = (await getCollection("social")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const t = (await getEntry("pageSections", "news"))?.data ?? {};
---

<BaseLayout title={t.seoTitle ?? "News & Events | GEOGLOWS"} description={t.seoDescription}>
  <section class="block">
    <div class="shell">
      <SectionHeader
        eyebrow={t.eyebrow ?? "News & events"}
        heading={t.heading ?? "Latest from the community"}
        align="left"
        level={1}
      />
      <div class="grid">
        {entries.map((entry) => <NewsCard {...entry.data} />)}
      </div>
      <p class="more-link"><a href="/videos">{t.videosLinkLabel ?? "Watch our videos"} →</a></p>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="block social">
        <div class="shell">
          <SectionHeader
            eyebrow={t.social?.eyebrow ?? "Social"}
            heading={t.social?.heading ?? "From our LinkedIn"}
            intro={t.social?.intro ?? "Announcements, community stories, and events, straight from the GEOGLOWS feed."}
            align="left"
          />
          <SocialFeed posts={posts} />
          <p class="more-link">
            <a href={t.followUrl ?? "https://www.linkedin.com/company/geoglows"} target="_blank" rel="noopener">
              {t.followLabel ?? "Follow GEOGLOWS on LinkedIn"} →
            </a>
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .social {
    background: var(--surface-wash);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .more-link {
    margin-top: 32px;
  }
  .more-link a {
    color: var(--accent-text);
    font-weight: 700;
    text-decoration: none;
  }
</style>
