---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const studies = await getCollection("case-studies");
  // Only a full case study earns a page; a field story links out instead.
  return studies
    .filter((s) => s.data.challenge)
    .map((s) => ({ params: { slug: s.id }, props: { study: s } }));
}

const { study } = Astro.props;
const d = study.data;
const arc = [
  { label: "Challenge", body: d.challenge },
  { label: "Intervention", body: d.intervention },
  { label: "Results", body: d.results },
  { label: "Lessons", body: d.lessons },
].filter((s) => s.body);
---

<BaseLayout title={`${d.title} | GEOGLOWS`} description={d.summary}>
  <article class="block study">
    <div class="shell">
      <a class="back" href="/impact#case-studies">← All case studies</a>
      <p class="loc">
        {d.location}
        <span class="kind">{d.kind}</span>
      </p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>

      {
        d.image && (
          <img
            class="band"
            src={d.image}
            alt={d.imageAlt ?? ""}
            width="1600"
            height="900"
            loading="eager"
            fetchpriority="high"
          />
        )
      }

      {
        d.partners.length > 0 && (
          <section class="orgs">
            <h2>Partners</h2>
            <ul>
              {d.partners.map((o) => (
                <li>
                  {o.url ? (
                    <a href={o.url} target="_blank" rel="noopener">
                      {o.name}
                    </a>
                  ) : (
                    o.name
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="arc">
        {
          arc.map((s) => (
            <section class:list={["step", { lesson: s.label === "Lessons" }]}>
              <h2>{s.label}</h2>
              <p>{s.body}</p>
            </section>
          ))
        }
      </div>

      {
        d.sourceUrl && (
          <p class="src">
            <a href={d.sourceUrl} target="_blank" rel="noopener">
              {d.source ? `Source: ${d.source}` : "Source"} →
            </a>
          </p>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .shell {
    max-width: 820px;
  }
  .back {
    display: inline-block;
    margin-bottom: 26px;
    color: var(--accent-text);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .loc {
    color: var(--accent-text);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .kind {
    margin-left: 10px;
    padding-left: 10px;
    border-left: 1px solid var(--border);
    color: var(--text-faint);
  }
  h1 {
    margin-top: 12px;
    max-width: 22ch;
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .lede {
    max-width: 62ch;
    margin-top: 18px;
    color: var(--text-body);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.6;
  }
  .band {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-top: 30px;
    border-radius: var(--radius);
  }
  .orgs {
    margin-top: 34px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .orgs h2 {
    color: var(--text-faint);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .orgs ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 9px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.92rem;
  }
  .orgs a {
    color: var(--text-strong);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
  }
  .orgs a:hover,
  .orgs a:focus-visible {
    color: var(--accent-text);
    text-decoration-color: currentColor;
  }

  /* The arc is the point of the page, so each step gets room rather than
     being compressed into a card. */
  .arc {
    margin-top: 12px;
  }
  .step {
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }
  .step h2 {
    color: var(--accent-text);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .step p {
    max-width: 68ch;
    margin-top: 10px;
    color: var(--text-body);
    font-size: 1rem;
    line-height: 1.68;
  }
  .step.lesson {
    border-top-width: 2px;
    border-top-color: var(--accent-text);
  }
  .step.lesson p {
    color: var(--text-strong);
    font-size: 1.08rem;
  }
  .src {
    margin-top: 32px;
  }
  .src a {
    color: var(--accent-text);
    font-weight: 700;
    text-decoration: none;
  }
</style>
