---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | GEOGLOWS" description="The page you are looking for could not be found.">
  <section class="notfound">
    <p class="code">404</p>
    <h1>We couldn't find that page</h1>
    <p class="lede">The page may have moved or no longer exists.</p>
    <a class="home" href="/">Back to home</a>
  </section>
</BaseLayout>

<style>
  .notfound {
    max-width: 40rem;
    margin: 0 auto;
    padding: 6rem 1.5rem 8rem;
    text-align: center;
  }
  .code {
    font-size: 3rem;
    font-weight: 800;
    color: var(--accent-text, #0060a9);
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }
  .notfound h1 {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .lede {
    color: var(--text-body, #4a5568);
    margin-bottom: 2rem;
  }
  .home {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    background: var(--color-blue, #0060a9);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
</style>
