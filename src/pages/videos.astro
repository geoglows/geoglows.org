---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import VideoCard from "../components/cards/VideoCard.astro";
import WebinarCard from "../components/cards/WebinarCard.astro";

const videos = (await getCollection("videos")).sort(
  (a, b) => a.data.order - b.data.order,
);
const webinars = (await getCollection("webinars")).sort(
  (a, b) => a.data.order - b.data.order,
);
const t = (await getEntry("pageSections", "videos"))?.data ?? {};
---

<BaseLayout
  title={t.seoTitle ?? "Videos & Webinars | GEOGLOWS"}
  description={t.seoDescription}
>
  {
    webinars.length > 0 && (
      <section class="block" id="webinars">
        <div class="shell">
          <SectionHeader
            eyebrow={t.webinars?.eyebrow ?? "Webinar series"}
            heading={t.webinars?.heading ?? "GEOGLOWS RFS v2 Webinar Series"}
            intro={t.webinars?.intro ?? "A four-part live series introducing the River Forecast System v2, from model formulation to accessing data and using the Hydroviewer."}
            align="left"
            level={1}
          />
          <div class="webinar-grid">
            {webinars.map((w) => (
              <WebinarCard {...w.data} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="block videos">
    <div class="shell">
      <SectionHeader
        eyebrow={t.videos?.eyebrow ?? "Videos"}
        heading={t.videos?.heading ?? "Talks, demos, and success stories"}
        intro={t.videos?.intro ?? "How GEOGLOWS hydrological modeling and GIS tools make a difference in water management around the world."}
        align="left"
      />
      <div class="grid">
        {videos.map((video) => <VideoCard {...video.data} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .webinar-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 22px;
  }
  .videos {
    background: var(--surface-wash);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
</style>
