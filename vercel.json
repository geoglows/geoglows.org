{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/what-we-do",
      "destination": "/tools",
      "permanent": false
    },
    {
      "source": "/apps",
      "destination": "https://apps.geoglows.org",
      "permanent": false
    },
    {
      "source": "/apps/:path*",
      "destination": "https://apps.geoglows.org/:path*",
      "permanent": false
    }
  ]
}
